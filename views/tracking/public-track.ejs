<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Portal Pelacakan Produksi - TRCH Screen Printing' %></title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .pulse-ring {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-ring {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.15); }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen py-6 px-3 sm:px-6 antialiased selection:bg-red-600 selection:text-white">

    <div class="max-w-3xl mx-auto">
        
        <!-- Brand Header (TRCH Screen Printing) -->
        <header class="text-center mb-6 sm:mb-8">
            <div class="inline-flex items-center space-x-3 mb-2 bg-black/60 border border-white/10 px-4 py-2 rounded-2xl shadow-xl backdrop-blur-md">
                <img src="/images/trch-logo.svg" alt="TRCH Logo" class="h-9 w-auto rounded border border-black bg-black shrink-0">
                <div class="text-left">
                    <h1 class="text-base sm:text-lg font-black tracking-tight text-white leading-tight">
                        TRCH <span class="text-red-500">SCREEN PRINTING</span>
                    </h1>
                    <p class="text-[10px] font-bold tracking-wider text-slate-400 uppercase">Kebumen &bull; Live Production Tracking</p>
                </div>
            </div>
            <p class="text-xs text-slate-400 max-w-md mx-auto mt-1">
                Pantau proses pengerjaan pesanan konveksi &amp; sablon Anda secara transparan dari meja potong hingga siap kirim.
            </p>
        </header>

        <!-- Search Box (Cari via No. PO / SPK / Kode Tracking) -->
        <div class="bg-slate-800/80 backdrop-blur-md p-2 rounded-2xl border border-slate-700/80 mb-6 shadow-xl">
            <form action="/track" method="GET" class="flex items-center space-x-2">
                <div class="relative flex-1">
                    <input type="text" name="code" value="<%= searchCode || '' %>" placeholder="Cari No. PO, No. SPK, atau Kode Tracking (misal: 1, SPK-202610-001, TRK-KAOS99)" class="w-full pl-9 pr-3 py-2.5 bg-slate-900/90 border border-slate-700 rounded-xl text-xs sm:text-sm text-white placeholder-slate-400 focus:ring-2 focus:ring-red-500 focus:outline-none">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-3"></i>
                </div>
                <button type="submit" class="bg-red-600 hover:bg-red-500 text-white font-bold px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm transition flex items-center space-x-1.5 shrink-0">
                    <i data-lucide="compass" class="w-4 h-4"></i>
                    <span>Lacak</span>
                </button>
            </form>
        </div>

        <!-- Notifikasi Error jika tidak ditemukan -->
        <% if (error) { %>
        <div class="bg-rose-500/10 border border-rose-500/30 text-rose-300 p-5 rounded-2xl text-center mb-6 shadow-lg">
            <i data-lucide="alert-triangle" class="w-8 h-8 mx-auto text-rose-400 mb-2"></i>
            <p class="text-sm font-bold text-rose-200"><%= error %></p>
            <p class="text-xs text-slate-400 mt-1">Silakan periksa kembali nomor PO atau kode tracking pada nota atau hubungi Admin TRCH.</p>
        </div>
        <% } %>

        <% if (order) { %>
        <!-- Card Detail Pesanan Utama -->
        <main class="bg-white text-slate-900 rounded-3xl p-5 sm:p-8 shadow-2xl border border-white/20 mb-6 space-y-6">
            
            <!-- Order Header & Status Badge -->
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 border-b border-slate-100 pb-5">
                <div>
                    <div class="flex flex-wrap items-center gap-2 mb-1.5">
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-red-100 text-red-800 border border-red-200">
                            PO #<%= order.po_number || 1 %>
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= order.category === 'jersey' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                            <%= order.category %>
                        </span>
                        <span class="font-mono text-xs text-slate-500 font-bold"><%= order.order_number %></span>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug"><%= order.article_name %></h2>
                    <p class="text-xs text-slate-500 mt-1">
                        Pemesan: <strong class="text-slate-800 font-bold"><%= order.customer_name %></strong>
                        <% if (order.customer_phone) { %>
                            &bull; Telp: <span class="font-mono"><%= order.customer_phone %></span>
                        <% } %>
                    </p>
                </div>

                <!-- Status Badge Realtime -->
                <div class="sm:text-right shrink-0">
                    <% if (order.status === 'COMPLETED') { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 shadow-xs">
                            <i data-lucide="check-check" class="w-4 h-4 mr-1.5 text-emerald-600"></i> Produksi Selesai
                        </span>
                    <% } else if (order.status === 'IN_PROGRESS') { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200 shadow-xs">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-ping mr-2"></span>
                            Sedang Dikerjakan: <span class="ml-1 font-black text-blue-900"><%= order.active_stage_name || 'Meja Produksi' %></span>
                        </span>
                    <% } else if (order.status === 'PAUSED') { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200 shadow-xs">
                            <i data-lucide="clock" class="w-4 h-4 mr-1.5 text-amber-600"></i> Dalam Proses (Dijeda)
                        </span>
                    <% } else if (order.status === 'CANCELLED') { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200 shadow-xs">
                            <i data-lucide="ban" class="w-4 h-4 mr-1.5 text-rose-600"></i> Pesanan Dibatalkan
                        </span>
                    <% } else { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 shadow-xs">
                            <i data-lucide="hourglass" class="w-4 h-4 mr-1.5 text-slate-500"></i> Menunggu Antrean
                        </span>
                    <% } %>
                </div>
            </div>

            <!-- Progress Bar Tracker -->
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80">
                <div class="flex justify-between items-center text-xs mb-2">
                    <span class="font-bold text-slate-700 flex items-center space-x-1.5">
                        <i data-lucide="activity" class="w-3.5 h-3.5 text-red-600"></i>
                        <span>Progres Produksi Keseluruhan</span>
                    </span>
                    <span class="font-black text-red-600 text-sm sm:text-base"><%= progressPercent %>%</span>
                </div>
                <div class="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden p-0.5 border border-slate-300">
                    <div class="h-full bg-gradient-to-r from-red-600 via-amber-500 to-emerald-500 rounded-full transition-all duration-700" style="width: <%= progressPercent %>%;"></div>
                </div>
                <div class="flex flex-col sm:flex-row justify-between text-[11px] text-slate-500 mt-2 gap-1">
                    <span>Tahapan Selesai: <strong class="text-slate-800"><%= completedStages %></strong> dari <strong class="text-slate-800"><%= totalStages %></strong> divisi</span>
                    <span>Target Jadi: <strong class="text-slate-900 font-bold"><%= order.tgl_jadi || order.deadline_date || '-' %></strong></span>
                </div>
            </div>

            <!-- SECTION MOCKUP VISUAL DESAIN (OPSI 1 & OPSI 2) -->
            <% if (order.mockup_front_url || order.mockup_back_url) { %>
            <div class="border border-slate-200 rounded-2xl p-4 sm:p-5 bg-gradient-to-b from-slate-50 to-white">
                <div class="flex items-center justify-between mb-3 border-b border-slate-200/80 pb-2.5">
                    <h3 class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900 flex items-center space-x-2">
                        <i data-lucide="image" class="w-4 h-4 text-purple-600"></i>
                        <span>Desain Mockup Produksi <%= (order.mockup_front_url && order.mockup_back_url) ? '(Opsi 1 & Opsi 2)' : '' %></span>
                    </h3>
                    <span class="text-[10px] font-bold text-purple-700 bg-purple-50 border border-purple-200 px-2 py-0.5 rounded-full">
                        Depan &amp; Belakang
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-<%= (order.mockup_front_url && order.mockup_back_url) ? 2 : 1 %> gap-4">
                    <!-- Opsi 1 -->
                    <% if (order.mockup_front_url) { %>
                    <div class="border border-slate-200 rounded-xl p-3 bg-white text-center shadow-xs">
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-purple-100 text-purple-800">OPSI 1</span>
                            <span class="text-[10px] font-bold text-slate-500">Tampak Depan &amp; Belakang</span>
                        </div>
                        <div class="w-full h-52 sm:h-60 flex items-center justify-center bg-slate-50 rounded-lg border border-slate-200 p-2 overflow-hidden group cursor-pointer" onclick="openImageModal('<%= order.mockup_front_url %>', 'Desain Opsi 1')">
                            <img src="<%= order.mockup_front_url %>" alt="Desain Opsi 1" class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300">
                        </div>
                        <p class="text-[10px] text-slate-400 mt-1.5 flex items-center justify-center space-x-1">
                            <i data-lucide="zoom-in" class="w-3 h-3"></i>
                            <span>Klik untuk memperbesar gambar</span>
                        </p>
                    </div>
                    <% } %>

                    <!-- Opsi 2 -->
                    <% if (order.mockup_back_url) { %>
                    <div class="border border-slate-200 rounded-xl p-3 bg-white text-center shadow-xs">
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-800">OPSI 2</span>
                            <span class="text-[10px] font-bold text-slate-500">Tampak Depan &amp; Belakang</span>
                        </div>
                        <div class="w-full h-52 sm:h-60 flex items-center justify-center bg-slate-50 rounded-lg border border-slate-200 p-2 overflow-hidden group cursor-pointer" onclick="openImageModal('<%= order.mockup_back_url %>', 'Desain Opsi 2')">
                            <img src="<%= order.mockup_back_url %>" alt="Desain Opsi 2" class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300">
                        </div>
                        <p class="text-[10px] text-slate-400 mt-1.5 flex items-center justify-center space-x-1">
                            <i data-lucide="zoom-in" class="w-3 h-3"></i>
                            <span>Klik untuk memperbesar gambar</span>
                        </p>
                    </div>
                    <% } %>
                </div>
            </div>
            <% } %>

            <!-- Timeline Tahapan Produksi (Vertical Stepper Modern) -->
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2 mb-4 flex items-center space-x-1.5">
                    <i data-lucide="git-commit" class="w-4 h-4 text-slate-500"></i>
                    <span>Tahapan Alur Kerja Meja Produksi</span>
                </h3>

                <div class="relative pl-6 sm:pl-8 space-y-5 before:absolute before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
                    <% stages.forEach((st, idx) => { %>
                    <div class="relative flex items-start space-x-3">
                        
                        <!-- Bullet Icon Marker -->
                        <div class="absolute -left-6 sm:-left-8 top-1 w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs ring-4 ring-white shadow-xs
                            <% if (st.status === 'COMPLETED') { %>
                                bg-emerald-500 text-white
                            <% } else if (st.status === 'IN_PROGRESS') { %>
                                bg-blue-600 text-white animate-pulse
                            <% } else if (st.status === 'PAUSED') { %>
                                bg-amber-500 text-white
                            <% } else { %>
                                bg-slate-200 text-slate-500
                            <% } %>
                        ">
                            <% if (st.status === 'COMPLETED') { %>
                                <i data-lucide="check" class="w-3.5 h-3.5"></i>
                            <% } else { %>
                                <%= idx + 1 %>
                            <% } %>
                        </div>

                        <!-- Content Card -->
                        <div class="flex-1 bg-slate-50 p-3 sm:p-4 rounded-2xl border <%= st.status === 'IN_PROGRESS' ? 'border-blue-400 bg-blue-50/40 shadow-xs' : 'border-slate-200/80' %>">
                            <div class="flex items-center justify-between">
                                <h4 class="text-sm font-bold <%= st.status === 'IN_PROGRESS' ? 'text-blue-900' : 'text-slate-800' %>">
                                    <%= st.stage_name %>
                                </h4>
                                <div>
                                    <% if (st.status === 'COMPLETED') { %>
                                        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">Selesai ✓</span>
                                    <% } else if (st.status === 'IN_PROGRESS') { %>
                                        <span class="text-[10px] font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded-full animate-pulse">Sedang Dikerjakan</span>
                                    <% } else if (st.status === 'PAUSED') { %>
                                        <span class="text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full">Dijeda</span>
                                    <% } else { %>
                                        <span class="text-[10px] font-medium text-slate-400">Menunggu Giliran</span>
                                    <% } %>
                                </div>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-1">
                                Penanggung Jawab: <span class="font-semibold text-slate-700"><%= ROLE_LABELS[st.assigned_role] || st.assigned_role %></span>
                                <% if (st.total_active_seconds > 0) { %>
                                    &bull; Durasi Kerja: <span class="font-mono text-slate-700"><%= formatDurationDetailed(st.total_active_seconds) %></span>
                                <% } %>
                            </p>
                        </div>

                    </div>
                    <% }) %>
                </div>
            </div>

            <!-- SPESIFIKASI DETAIL PRODUKSI & RINCIAN UKURAN -->
            <div class="space-y-4 pt-2">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2 flex items-center space-x-1.5">
                    <i data-lucide="clipboard-list" class="w-4 h-4 text-slate-500"></i>
                    <span>Spesifikasi Produksi &amp; Rincian Ukuran</span>
                </h3>

                <!-- Info Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-200 text-xs text-slate-600">
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Kain / Bahan</span>
                        <span class="font-bold text-slate-900"><%= order.fabric_type || '-' %></span>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Warna Kaos</span>
                        <span class="font-bold text-slate-900"><%= order.warna_kaos || '-' %></span>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Tinta / Sablon</span>
                        <span class="font-bold text-slate-900"><%= order.tinta_type || order.print_type || '-' %></span>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Finishing</span>
                        <span class="font-bold text-slate-900"><%= order.finishing_type || '-' %></span>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Ekspedisi / Kirim</span>
                        <span class="font-bold text-slate-900"><%= order.shipping_courier || '-' %></span>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Total Jumlah Order</span>
                        <span class="font-black text-red-600 text-sm"><%= order.total_pcs %> Pcs</span>
                    </div>
                </div>

                <!-- Rincian Ukuran (Size Breakdown) -->
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200">
                    <span class="text-[10px] uppercase font-bold text-slate-400 block mb-2">Rincian Ukuran (Size Breakdown):</span>
                    <div class="grid grid-cols-3 sm:grid-cols-9 gap-2 text-center text-xs">
                        <% [
                            { label: 'XS', val: order.size_xs },
                            { label: 'S', val: order.size_s },
                            { label: 'M', val: order.size_m },
                            { label: 'L', val: order.size_l },
                            { label: 'XL', val: order.size_xl },
                            { label: '2XL', val: order.size_2xl },
                            { label: '3XL', val: order.size_3xl },
                            { label: '4XL', val: order.size_4xl },
                            { label: '5XL', val: order.size_5xl }
                        ].forEach(sz => { %>
                        <div class="p-2 bg-white rounded-xl border border-slate-200 shadow-xs">
                            <span class="block text-[10px] font-bold text-slate-400 uppercase"><%= sz.label %></span>
                            <span class="block text-sm font-black text-slate-800"><%= sz.val || 0 %></span>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- HASIL QC & MUTU (JIKA SUDAH LEWAT TAHAP QC) -->
            <% if (qcResult) { %>
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-xs space-y-2">
                <div class="flex items-center justify-between">
                    <span class="font-black text-emerald-900 uppercase flex items-center space-x-1.5">
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                        <span>Pemeriksaan Kualitas (QC Pass)</span>
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-emerald-200 text-emerald-900">
                        <%= Number(qcResult.pass_percentage).toFixed(1) %>% Lolos QC
                    </span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center pt-1">
                    <div class="bg-white p-2 rounded-xl border border-emerald-100">
                        <span class="text-[10px] text-slate-400 uppercase font-bold block">Diperiksa</span>
                        <span class="font-bold text-slate-800"><%= qcResult.total_checked %> pcs</span>
                    </div>
                    <div class="bg-white p-2 rounded-xl border border-emerald-100">
                        <span class="text-[10px] text-emerald-600 uppercase font-bold block">Lolos</span>
                        <span class="font-bold text-emerald-700"><%= qcResult.pcs_passed %> pcs</span>
                    </div>
                    <div class="bg-white p-2 rounded-xl border border-emerald-100">
                        <span class="text-[10px] text-rose-500 uppercase font-bold block">Reject</span>
                        <span class="font-bold text-rose-600"><%= qcResult.pcs_reject %> pcs</span>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- TOMBOL AKSI: BAGIKAN KE WHATSAPP & SALIN TAUTAN -->
            <div class="pt-2 border-t border-slate-100 flex flex-col sm:flex-row items-center gap-2.5">
                <!-- Salin Link -->
                <button type="button" onclick="copyTrackingLink()" class="w-full sm:flex-1 py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-2xl text-xs flex items-center justify-center space-x-2 transition shadow-md">
                    <i data-lucide="share-2" class="w-4 h-4"></i>
                    <span id="copyBtnText">Salin Tautan Tracking</span>
                </button>

                <!-- Share WA -->
                <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('Halo, berikut link pelacakan progres produksi pesanan di TRCH Screen Printing:\n' + order.article_name + ' (PO #' + (order.po_number || 1) + ')\nStatus: ' + (order.active_stage_name || order.status) + '\n\nCek di sini: ') %>" id="waShareBtn" target="_blank" class="w-full sm:flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-2xl text-xs flex items-center justify-center space-x-2 transition shadow-md">
                    <i data-lucide="message-circle" class="w-4 h-4"></i>
                    <span>Bagikan ke WhatsApp</span>
                </a>
            </div>

        </main>
        <% } %>

        <!-- Footer -->
        <footer class="text-center text-xs text-slate-500 space-y-1.5 pb-8">
            <p>Halaman ini diperbarui secara otomatis sesuai pergerakan di lantai produksi.</p>
            <p>&copy; TRCH Screen Printing &bull; Kebumen POK &amp; WIP Production System</p>
        </footer>

    </div>

    <!-- MODAL LIGHTBOX UNTUK MEMPERBESAR MOCKUP -->
    <div id="imageModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4" onclick="closeImageModal()">
        <div class="relative max-w-2xl w-full bg-white rounded-2xl p-4 shadow-2xl" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                <h4 id="imageModalTitle" class="text-sm font-black uppercase tracking-wider text-slate-800">Preview Desain</h4>
                <button type="button" onclick="closeImageModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-sm">&times;</button>
            </div>
            <div class="py-4 flex items-center justify-center max-h-[70vh] overflow-hidden">
                <img id="imageModalImg" src="" alt="Zoom Mockup" class="max-h-[65vh] max-w-full object-contain rounded-lg">
            </div>
        </div>
    </div>

    <script src="/js/tracking-page.js"></script>
    <script>
        // Update URL tombol WhatsApp dengan URL saat ini
        const waBtn = document.getElementById('waShareBtn');
        if (waBtn) {
            const currentHref = waBtn.getAttribute('href');
            waBtn.setAttribute('href', currentHref + encodeURIComponent(window.location.href));
        }

        // Lightbox Functions
        function openImageModal(imgSrc, title) {
            document.getElementById('imageModalImg').src = imgSrc;
            document.getElementById('imageModalTitle').textContent = title || 'Preview Desain';
            document.getElementById('imageModal').classList.remove('hidden');
        }

        function closeImageModal() {
            document.getElementById('imageModal').classList.add('hidden');
            document.getElementById('imageModalImg').src = '';
        }

        if (window.lucide) {
            lucide.createIcons();
        }
    </script>
</body>
</html>
