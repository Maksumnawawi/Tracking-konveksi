<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
            
            <!-- Brand / Logo -->
            <div class="flex items-center space-x-3">
                <a href="<%= currentUser && currentUser.role === 'admin' ? '/admin/dashboard' : '/division/queue' %>" class="flex items-center space-x-2.5 group">
                    <img src="/images/trch-logo.svg" alt="TRCH Logo" class="h-9 w-auto rounded border border-black shadow-sm group-hover:scale-105 transition">
                    <div>
                        <span class="text-base font-black tracking-tight text-slate-900 block leading-tight">TRCH <span class="text-red-600">SCREEN PRINTING</span></span>
                        <span class="text-[10px] font-bold tracking-wider text-slate-400 block -mt-0.5">Kebumen &bull; POK &amp; WIP System</span>
                    </div>
                </a>
            </div>

            <!-- User Info & Navigasi -->
            <% if (currentUser) { %>
            <div class="flex items-center space-x-3 sm:space-x-4">
                
                <!-- KHUSUS OWNER: Menu Cepat Pantau Meja Divisi Tanpa Login Lagi -->
                <% if (currentUser.role === 'admin') { %>
                <div class="hidden sm:flex items-center space-x-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs">
                    <span class="text-[11px] font-bold text-slate-500 px-2 flex items-center space-x-1">
                        <i data-lucide="eye" class="w-3.5 h-3.5 text-purple-600"></i>
                        <span>Pantau Meja:</span>
                    </span>
                    <form action="/division/queue" method="GET" class="m-0">
                        <select name="view_role" onchange="this.form.submit()" class="bg-white border border-slate-300 rounded-lg font-bold text-slate-700 py-1 px-2.5 text-xs focus:ring-2 focus:ring-purple-500 focus:outline-none cursor-pointer">
                            <option value="" disabled selected>-- Pilih Meja Divisi --</option>
                            <option value="desain">🎨 Meja Desain</option>
                            <option value="print_sablon">🖨️ Meja Sablon & Sublim</option>
                            <option value="potong">✂️ Meja Potong</option>
                            <option value="jahit">🧵 Meja Jahit</option>
                            <option value="qc_packing">🔍 Meja QC & Packing</option>
                            <option value="kirim">📦 Meja Kirim</option>
                        </select>
                    </form>
                </div>
                <% } %>

                <!-- Current Role Badge -->
                <div class="text-right">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= ROLE_BADGES[currentUser.role] || 'bg-slate-100 text-slate-800' %>">
                        <%= ROLE_LABELS[currentUser.role] || currentUser.division_name %>
                    </span>
                    <p class="text-xs text-slate-500 hidden md:block mt-0.5"><%= currentUser.full_name %></p>
                </div>

                <!-- Tombol Logout -->
                <a href="/logout" title="Keluar / Ganti Akun" class="flex items-center space-x-1.5 px-3 py-1.5 text-xs font-bold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition border border-rose-200/60">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Keluar</span>
                </a>
            </div>
            <% } else { %>
            <div>
                <a href="/login" class="text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg shadow-sm transition">Masuk Akun &rarr;</a>
            </div>
            <% } %>

        </div>
    </div>
</header>
