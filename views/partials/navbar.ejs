<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8">
        <div class="flex justify-between h-14 sm:h-16 items-center gap-1.5 sm:gap-4">
            
            <!-- Brand / Logo -->
            <div class="flex items-center min-w-0 shrink">
                <a href="<%= currentUser && currentUser.role === 'admin' ? '/admin/dashboard' : '/division/queue' %>" class="flex items-center space-x-2 group min-w-0">
                    <img src="/images/trch-logo.svg" alt="TRCH Logo" class="h-8 sm:h-9 w-auto rounded border border-black shadow-sm group-hover:scale-105 transition shrink-0 bg-black">
                    <div class="min-w-0">
                        <span class="text-xs sm:text-base font-black tracking-tight text-slate-900 block leading-tight truncate">TRCH <span class="text-red-600">SCREEN PRINTING</span></span>
                        <span class="text-[9px] sm:text-[10px] font-bold tracking-wider text-slate-400 hidden sm:block -mt-0.5">Kebumen &bull; POK &amp; WIP System</span>
                    </div>
                </a>
            </div>

            <!-- User Info & Navigasi -->
            <% if (currentUser) { %>
            <div class="flex items-center space-x-1 sm:space-x-2.5 shrink-0">
                
                <!-- KHUSUS OWNER: Menu Cepat Pantau Meja Divisi Tanpa Login Lagi -->
                <% if (currentUser.role === 'admin') { %>
                <div class="hidden md:flex items-center space-x-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs">
                    <span class="text-[11px] font-bold text-slate-500 px-2 flex items-center space-x-1">
                        <i data-lucide="eye" class="w-3.5 h-3.5 text-purple-600"></i>
                        <span>Pantau Meja:</span>
                    </span>
                    <form action="/division/queue" method="GET" class="m-0">
                        <select name="view_role" onchange="this.form.submit()" class="bg-white border border-slate-300 rounded-lg font-bold text-slate-700 py-1 px-2.5 text-xs focus:ring-2 focus:ring-purple-500 focus:outline-none cursor-pointer">
                            <option value="" disabled selected>-- Pilih Meja Divisi --</option>
                            <option value="desain">🎨 Meja Desain</option>
                            <option value="print_sablon">🖨️ Meja Sablon & Sublim</option>
                            <option value="potong">✂️ Meja Potong</option>
                            <option value="jahit">🧵 Meja Jahit</option>
                            <option value="qc_packing">🔍 Meja QC & Packing</option>
                            <option value="kirim">📦 Meja Kirim</option>
                        </select>
                    </form>
                </div>
                <% } %>

                <!-- Current Role Badge -->
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-semibold <%= ROLE_BADGES[currentUser.role] || 'bg-slate-100 text-slate-800' %>">
                    <%= ROLE_LABELS[currentUser.role] || currentUser.division_name %>
                </span>

                <!-- Tombol Ganti Sandi Akun -->
                <button type="button" onclick="openSelfPasswordModal()" title="Ganti Kata Sandi Akun" class="flex items-center space-x-1 p-1.5 sm:px-2.5 sm:py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition border border-slate-200">
                    <i data-lucide="key" class="w-3.5 h-3.5 text-slate-500"></i>
                    <span class="hidden md:inline">Sandi</span>
                </button>

                <!-- Khusus Admin: Tombol Kelola Tim & Sandi Semua Divisi -->
                <% if (currentUser.role === 'admin') { %>
                <button type="button" onclick="openAdminTeamModal()" title="Kelola Tim & Kata Sandi Divisi" class="flex items-center space-x-1 p-1.5 sm:px-2.5 sm:py-1.5 text-xs font-bold text-purple-700 hover:text-purple-900 bg-purple-50 hover:bg-purple-100 rounded-lg transition border border-purple-200">
                    <i data-lucide="users" class="w-3.5 h-3.5 text-purple-600"></i>
                    <span class="hidden lg:inline">Kelola Tim</span>
                </button>
                <% } %>

                <!-- Tombol Logout -->
                <a href="/logout" title="Keluar / Ganti Akun" class="flex items-center space-x-1 p-1.5 sm:px-2.5 sm:py-1.5 text-xs font-bold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition border border-rose-200/60">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    <span class="hidden md:inline">Keluar</span>
                </a>
            </div>
            <% } else { %>
            <div>
                <a href="/login" class="text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg shadow-sm transition">Masuk Akun &rarr;</a>
            </div>
            <% } %>

        </div>
    </div>
</header>

<!-- MODAL GANTI SANDI AKUN SENDIRI -->
<div id="selfPasswordModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl text-slate-900 border border-slate-200">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <h3 class="text-sm font-black text-slate-900 flex items-center space-x-2">
                <i data-lucide="key" class="w-4 h-4 text-blue-600"></i>
                <span>Ganti Kata Sandi Akun</span>
            </h3>
            <button type="button" onclick="closeSelfPasswordModal()" class="text-slate-400 hover:text-slate-600 p-1">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form id="selfPasswordForm" onsubmit="handleSelfPasswordSubmit(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Kata Sandi Baru (Min. 4 Karakter)</label>
                <input type="password" id="selfNewPassword" required minlength="4" placeholder="••••••••" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Ulangi Kata Sandi Baru</label>
                <input type="password" id="selfConfirmPassword" required minlength="4" placeholder="••••••••" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>

            <div id="selfPwMsg" class="hidden text-xs font-bold p-2.5 rounded-lg"></div>

            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="closeSelfPasswordModal()" class="px-3.5 py-2 border border-slate-300 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-50">
                    Batal
                </button>
                <button type="submit" id="btnSelfPwSubmit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-500/20">
                    Simpan Sandi Baru
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KHUSUS ADMIN: MODAL KELOLA TIM & SANDI SEMUA DIVISI -->
<% if (currentUser && currentUser.role === 'admin') { %>
<div id="adminTeamModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl text-slate-900 border border-slate-200 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-black text-slate-900 flex items-center space-x-2">
                    <i data-lucide="users" class="w-5 h-5 text-purple-600"></i>
                    <span>Kelola Nama Tim &amp; Kata Sandi Divisi</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Admin dapat mengedit nama kepala divisi dan mereset kata sandi masing-masing akun.</p>
            </div>
            <button type="button" onclick="closeAdminTeamModal()" class="text-slate-400 hover:text-slate-600 p-1">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div id="teamUsersList" class="space-y-3">
            <p class="text-xs text-slate-400 text-center py-4">Memuat data tim...</p>
        </div>
    </div>
</div>
<% } %>

<script>
    function openSelfPasswordModal() {
        document.getElementById('selfPasswordModal').classList.remove('hidden');
        document.getElementById('selfNewPassword').value = '';
        document.getElementById('selfConfirmPassword').value = '';
        const msg = document.getElementById('selfPwMsg');
        msg.className = 'hidden text-xs font-bold p-2.5 rounded-lg';
    }

    function closeSelfPasswordModal() {
        document.getElementById('selfPasswordModal').classList.add('hidden');
    }

    async function handleSelfPasswordSubmit(e) {
        e.preventDefault();
        const newPw = document.getElementById('selfNewPassword').value;
        const confirmPw = document.getElementById('selfConfirmPassword').value;
        const msg = document.getElementById('selfPwMsg');
        const btn = document.getElementById('btnSelfPwSubmit');

        if (newPw !== confirmPw) {
            msg.className = 'text-xs font-bold p-2.5 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 block';
            msg.textContent = 'Konfirmasi kata sandi tidak cocok!';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Menyimpan...';

        try {
            const res = await fetch('/auth/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ new_password: newPw, confirm_password: confirmPw })
            });
            const data = await res.json();
            if (data.success) {
                msg.className = 'text-xs font-bold p-2.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 block';
                msg.textContent = '✔ Kata sandi berhasil diperbarui!';
                setTimeout(() => { closeSelfPasswordModal(); }, 1500);
            } else {
                msg.className = 'text-xs font-bold p-2.5 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 block';
                msg.textContent = data.message || 'Gagal mengubah sandi.';
            }
        } catch (err) {
            msg.className = 'text-xs font-bold p-2.5 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 block';
            msg.textContent = 'Koneksi error: ' + err.message;
        } finally {
            btn.disabled = false;
            btn.textContent = 'Simpan Sandi Baru';
        }
    }

    async function openAdminTeamModal() {
        const modal = document.getElementById('adminTeamModal');
        if (!modal) return;
        modal.classList.remove('hidden');
        const listContainer = document.getElementById('teamUsersList');
        listContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">Memuat data tim...</p>';

        try {
            const res = await fetch('/admin/users/api');
            const data = await res.json();
            if (!data.success || !data.users) {
                listContainer.innerHTML = '<p class="text-xs text-rose-500 text-center py-4">Gagal memuat tim.</p>';
                return;
            }

            let html = '';
            data.users.forEach(u => {
                const isAdm = u.username === 'admin';
                const defaultPwHint = isAdm ? 'admin123' : '123456';
                html += `
                <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="sm:w-1/3">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-black uppercase text-slate-900">${u.division_name || u.role}</span>
                            <span class="text-[10px] font-bold text-slate-500 bg-white border border-slate-200 px-1.5 py-0.5 rounded">${u.username}</span>
                        </div>
                        <input type="text" id="name_${u.id}" value="${u.full_name || 'Nama Kepala'}" placeholder="Nama Kepala" class="mt-1 w-full px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-800 focus:ring-2 focus:ring-purple-500 focus:outline-none">
                    </div>
                    
                    <div class="sm:w-1/2 flex items-center space-x-2">
                        <div class="flex-1">
                            <label class="block text-[10px] font-bold text-slate-500">Sandi Baru (Kosongkan jika tdk ganti):</label>
                            <input type="password" id="pw_${u.id}" placeholder="Default: ${defaultPwHint}" class="w-full px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-purple-500 focus:outline-none">
                        </div>
                        <button type="button" onclick="saveUserData(${u.id})" class="mt-3.5 px-3 py-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-lg text-xs transition shadow-xs">
                            Simpan
                        </button>
                    </div>
                </div>
                `;
            });

            listContainer.innerHTML = html;
        } catch (err) {
            listContainer.innerHTML = `<p class="text-xs text-rose-500 text-center py-4">Error: ${err.message}</p>`;
        }
    }

    function closeAdminTeamModal() {
        const modal = document.getElementById('adminTeamModal');
        if (modal) modal.classList.add('hidden');
    }

    async function saveUserData(userId) {
        const nameInput = document.getElementById(`name_${userId}`);
        const pwInput = document.getElementById(`pw_${userId}`);
        const fullName = nameInput ? nameInput.value : '';
        const newPassword = pwInput ? pwInput.value : '';

        try {
            const res = await fetch('/admin/users/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: userId, full_name: fullName, new_password: newPassword })
            });
            const data = await res.json();
            if (data.success) {
                alert('✔ Data akun berhasil disimpan!');
                if (pwInput) pwInput.value = '';
            } else {
                alert('Gagal: ' + data.message);
            }
        } catch (err) {
            alert('Error koneksi: ' + err.message);
        }
    }
</script>
