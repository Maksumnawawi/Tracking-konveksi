<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0">
        
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <a href="/admin/orders/<%= order.id %>" class="text-xs font-semibold text-slate-500 hover:text-slate-800 flex items-center space-x-1 mb-1">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                    <span>Kembali ke Detail Pesanan</span>
                </a>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Edit Pesanan: <%= order.order_number %></h1>
                <p class="text-xs text-slate-500">Owner dapat menambah/mengubah jumlah order (Pcs) atau spesifikasi saat pesanan sedang berjalan di lantai produksi.</p>
            </div>
            <div>
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-purple-100 text-purple-800 border border-purple-200">
                    👑 Hak Akses Owner
                </span>
            </div>
        </div>

        <% if (error) { %>
        <div class="mb-6 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-sm flex items-center space-x-2">
            <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 text-rose-500"></i>
            <span><%= error %></span>
        </div>
        <% } %>

        <form action="/admin/orders/<%= order.id %>/edit" method="POST" class="space-y-6">
            
            <!-- Banner Status Saat Ini -->
            <div class="p-4 bg-slate-100 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs">
                <div>
                    <span class="text-slate-500">Posisi Meja Produksi Saat Ini:</span>
                    <strong class="text-slate-900 ml-1"><%= order.active_stage_name || '-' %> (<%= ROLE_LABELS[order.current_role] || order.current_role %>)</strong>
                </div>
                <div>
                    <span class="text-slate-500">Jumlah Order Sebelumnya:</span>
                    <strong class="text-blue-700 ml-1 font-mono text-sm"><%= order.total_pcs %> Pcs</strong>
                </div>
            </div>

            <!-- Section 1: Rincian Ukuran / Penambahan Jumlah Order & Model Varian -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-3 gap-2">
                    <div>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2">
                            <i data-lucide="plus-circle" class="w-4 h-4 text-emerald-600"></i>
                            <span>1. Ubah / Tambah Jumlah Order (Size Breakdown)</span>
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Ubah angka pada ukuran yang ingin ditambah atau dikurangi per varian model</p>
                    </div>
                    <div class="flex items-center space-x-2 self-start sm:self-auto">
                        <span class="text-xs text-slate-500 font-semibold">Total Baru:</span>
                        <div class="text-xs font-bold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 shadow-2xs">
                            <span id="displayTotalPcs" class="text-sm font-black"><%= order.total_pcs %></span> Pcs
                        </div>
                    </div>
                </div>

                <!-- Input Warna Kaos (Sesuai Gambar No. 4 di Kertas) -->
                <div class="p-4 bg-amber-50/70 border border-amber-200/80 rounded-2xl space-y-1">
                    <label class="block text-xs font-black text-amber-950 uppercase tracking-wider flex items-center space-x-1.5">
                        <i data-lucide="palette" class="w-4 h-4 text-amber-600"></i>
                        <span>Warna Kaos / Bahan Kain</span>
                    </label>
                    <input type="text" name="warna_kaos" id="warnaKaosInput" value="<%= order.warna_kaos || 'HITAM, PUTIH' %>" placeholder="Contoh: HITAM atau HITAM, PUTIH" class="w-full px-3.5 py-2.5 bg-white border border-amber-300 rounded-xl text-sm font-black text-slate-900 focus:ring-2 focus:ring-amber-500 focus:outline-none uppercase">
                    <span class="text-[11px] text-amber-800/80 block">Bisa masukkan 1 warna atau beberapa warna dipisah koma (Contoh: <strong>HITAM</strong> atau <strong>HITAM, PUTIH</strong>)</span>
                </div>

                <!-- Kotak Ceklis Pilihan Varian (Dewasa, Anak, Pendek, Panjang) -->
                <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-slate-800 uppercase tracking-wider flex items-center space-x-1.5">
                            <i data-lucide="check-square" class="w-4 h-4 text-blue-600"></i>
                            <span>Pilih Model yang Dikerjakan (Ceklis / Centang):</span>
                        </span>
                        <span class="text-[11px] text-slate-500 hidden sm:inline">Centang untuk memunculkan baris ukuran</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <!-- 1. Dewasa Pendek -->
                        <label id="label_dewasa_pendek" class="flex items-center space-x-3 p-3 bg-white border border-slate-300 rounded-xl cursor-pointer transition select-none shadow-2xs hover:border-blue-400">
                            <input type="checkbox" id="chk_dewasa_pendek" onchange="handlePresetCheck('dewasa_pendek', this.checked)" class="w-5 h-5 text-blue-600 rounded focus:ring-blue-500 cursor-pointer">
                            <div class="flex-1">
                                <span class="text-xs font-black text-slate-900 block">👕 Dewasa - Lengan Pendek</span>
                                <span class="text-[10px] text-slate-500">Kaos oblong / polo standar dewasa lengan pendek</span>
                            </div>
                        </label>

                        <!-- 2. Dewasa Panjang -->
                        <label id="label_dewasa_panjang" class="flex items-center space-x-3 p-3 bg-white border border-slate-300 rounded-xl cursor-pointer transition select-none shadow-2xs hover:border-indigo-400">
                            <input type="checkbox" id="chk_dewasa_panjang" onchange="handlePresetCheck('dewasa_panjang', this.checked)" class="w-5 h-5 text-indigo-600 rounded focus:ring-indigo-500 cursor-pointer">
                            <div class="flex-1">
                                <span class="text-xs font-black text-slate-900 block">🥋 Dewasa - Lengan Panjang</span>
                                <span class="text-[10px] text-slate-500">Kaos / jersey dewasa lengan panjang</span>
                            </div>
                        </label>

                        <!-- 3. Anak Pendek -->
                        <label id="label_anak_pendek" class="flex items-center space-x-3 p-3 bg-white border border-slate-300 rounded-xl cursor-pointer transition select-none shadow-2xs hover:border-amber-400">
                            <input type="checkbox" id="chk_anak_pendek" onchange="handlePresetCheck('anak_pendek', this.checked)" class="w-5 h-5 text-amber-600 rounded focus:ring-amber-500 cursor-pointer">
                            <div class="flex-1">
                                <span class="text-xs font-black text-slate-900 block">🧒 Anak-Anak - Lengan Pendek</span>
                                <span class="text-[10px] text-slate-500">Kaos anak ukuran XS (2th) s/d 2XL (12th)</span>
                            </div>
                        </label>

                        <!-- 4. Anak Panjang -->
                        <label id="label_anak_panjang" class="flex items-center space-x-3 p-3 bg-white border border-slate-300 rounded-xl cursor-pointer transition select-none shadow-2xs hover:border-purple-400">
                            <input type="checkbox" id="chk_anak_panjang" onchange="handlePresetCheck('anak_panjang', this.checked)" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500 cursor-pointer">
                            <div class="flex-1">
                                <span class="text-xs font-black text-slate-900 block">🧒🥋 Anak-Anak - Lengan Panjang</span>
                                <span class="text-[10px] text-slate-500">Kaos / jersey anak lengan panjang</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Header Tabel Baris -->
                <div class="flex items-center justify-between pt-1">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center space-x-1">
                        <i data-lucide="list" class="w-3.5 h-3.5 text-blue-600"></i>
                        <span>Rincian Ukuran yang Dicentang:</span>
                    </span>
                    <button type="button" onclick="addCustomVariantRow()" class="text-[11px] font-bold text-slate-500 hover:text-blue-700 hover:underline flex items-center space-x-1 cursor-pointer">
                        <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                        <span>+ Tambah Varian Khusus Lain</span>
                    </button>
                </div>

                <!-- Container Kartu-Kartu Varian -->
                <div id="variantCardsContainer" class="space-y-3">
                    <!-- Di-render dinamis oleh JavaScript -->
                </div>

                <!-- Catatan Tambahan Kaos Lain / Catatan Ukuran -->
                <div class="pt-2 border-t border-slate-100">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 flex items-center justify-between">
                        <span class="flex items-center space-x-1.5">
                            <i data-lucide="edit-3" class="w-3.5 h-3.5 text-blue-600"></i>
                            <span>Catatan Tambahan / Kaos Lain (Opsional):</span>
                        </span>
                        <span class="text-[10px] text-slate-400 font-normal">Tulis jika ada catatan kaos khusus/tambahan</span>
                    </label>
                    <input type="text" name="variant_notes" value="<%= order.variant_notes || '' %>" placeholder="Contoh: Kaos warna abu misty 2 pcs size L, model crop top 1 pcs, rib lengan karet..." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Selisih Tambahan Alert -->
                <div id="diffAlertBox" class="hidden p-3 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-900 flex items-center justify-between">
                    <span id="diffAlertText" class="font-semibold"></span>
                    <span class="text-[10px] text-blue-600">Sistem akan otomatis mengirim notifikasi ke PIC divisi yang sedang mengerjakan</span>
                </div>

                <!-- Hidden inputs untuk sinkronisasi form & database -->
                <input type="hidden" name="items_breakdown_json" id="items_breakdown_json" value="<%= order.items_breakdown_json || '' %>">
                <input type="hidden" name="size_xs" id="sum_size_xs" value="<%= order.size_xs || 0 %>">
                <input type="hidden" name="size_s" id="sum_size_s" value="<%= order.size_s || 0 %>">
                <input type="hidden" name="size_m" id="sum_size_m" value="<%= order.size_m || 0 %>">
                <input type="hidden" name="size_l" id="sum_size_l" value="<%= order.size_l || 0 %>">
                <input type="hidden" name="size_xl" id="sum_size_xl" value="<%= order.size_xl || 0 %>">
                <input type="hidden" name="size_2xl" id="sum_size_2xl" value="<%= order.size_2xl || 0 %>">
                <input type="hidden" name="size_3xl" id="sum_size_3xl" value="<%= order.size_3xl || 0 %>">
                <input type="hidden" name="size_4xl" id="sum_size_4xl" value="<%= order.size_4xl || 0 %>">
                <input type="hidden" name="size_5xl" id="sum_size_5xl" value="<%= order.size_5xl || 0 %>">
                <input type="hidden" name="total_pcs" id="sum_total_pcs" value="<%= order.total_pcs || 0 %>">
            </div>

            <!-- Section 2: Catatan Revisi & Notifikasi untuk Divisi -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 border-b border-slate-100 pb-3">
                    <i data-lucide="bell" class="w-4 h-4 text-amber-500"></i>
                    <span>2. Pesan Notifikasi untuk Meja Divisi</span>
                </h2>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Pesan / Alasan Perubahan (Akan Muncul di Meja PIC)</label>
                    <textarea name="revision_notes" rows="2" placeholder="Contoh: Customer nambah 10 pcs ukuran L karena ada penambahan anggota panitia. Mohon sablon dan potong disesuaikan." class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
                    <p class="text-[11px] text-slate-400 mt-1">Pesan ini akan langsung muncul sebagai notifikasi kartu di antrean divisi terkait.</p>
                </div>
            </div>

            <!-- Section 3: Informasi Pesanan Lainnya -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 border-b border-slate-100 pb-3">
                    <i data-lucide="edit-3" class="w-4 h-4 text-blue-600"></i>
                    <span>3. Info Artikel, Kain, Sablon & Deadline</span>
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nomor PO TRCH (Bisa Diedit)</label>
                        <input type="number" min="1" name="po_number" value="<%= order.po_number || order.id %>" class="w-full px-3.5 py-2.5 border-2 border-amber-300 font-black rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none bg-amber-50/40">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Pelanggan</label>
                        <input type="text" name="customer_name" required value="<%= order.customer_name %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nomor WhatsApp</label>
                        <input type="text" name="customer_phone" value="<%= order.customer_phone || '' %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Alamat Pelanggan</label>
                        <input type="text" name="customer_address" value="<%= order.customer_address || '' %>" placeholder="Contoh: Sumelang, Gemeksekti, Kebumen" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Model Kerah Baju</label>
                        <input type="text" name="collar_type" value="<%= order.collar_type || '' %>" placeholder="Contoh: V-Neck Silang / O-Neck / Shanghai" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Catatan Spesifikasi Kerah</label>
                        <input type="text" name="collar_notes" value="<%= order.collar_notes || '' %>" placeholder="Contoh: Rib leher hitam list putih 2cm..." class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Catatan Kategori (Kaos / Jersey)</label>
                        <input type="text" name="category_notes" value="<%= order.category_notes || '' %>" placeholder="Contoh: Jersey sublim full print gradasi..." class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Artikel / Desain</label>
                        <input type="text" name="article_name" required value="<%= order.article_name %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Jenis Bahan Kain</label>
                        <input type="text" name="fabric_type" value="<%= order.fabric_type || '' %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Jenis Sablon / Sublim</label>
                        <input type="text" name="print_type" value="<%= order.print_type || '' %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Deadline Selesai</label>
                        <input type="date" name="deadline_date" value="<%= order.deadline_date || '' %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Catatan Instruksi SPK</label>
                        <textarea name="notes" rows="2" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= order.notes || '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Tombol Aksi Simpan -->
            <div class="flex items-center justify-end space-x-3 pt-2">
                <a href="/admin/orders/<%= order.id %>" class="px-5 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
                    Batal
                </a>
                <button type="submit" class="inline-flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-2.5 rounded-xl text-sm shadow-lg shadow-blue-500/20 transition">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Simpan Perubahan & Beri Notifikasi</span>
                </button>
            </div>

        </form>

    </main>
</div>

<script>
    const originalTotal = <%= order.total_pcs %>;

    // Multi-Variant Size Breakdown Manager (Sistem Ceklis Model & Ukuran)
    const PRESETS = {
        dewasa_pendek: { name: 'Lengan Pendek (Dewasa)', icon: '👕', badgeColor: 'bg-blue-100 text-blue-900 border-blue-200' },
        dewasa_panjang: { name: 'Lengan Panjang (Dewasa)', icon: '🥋', badgeColor: 'bg-indigo-100 text-indigo-900 border-indigo-200' },
        anak_pendek: { name: 'Lengan Pendek (Anak-Anak)', icon: '🧒', badgeColor: 'bg-amber-100 text-amber-900 border-amber-200' },
        anak_panjang: { name: 'Lengan Panjang (Anak-Anak)', icon: '🧒🥋', badgeColor: 'bg-purple-100 text-purple-900 border-purple-200' }
    };

    let variants = [];
    const originalTotalPcs = <%= order.total_pcs || 0 %>;

    try {
        const rawSaved = document.getElementById('items_breakdown_json').value;
        if (rawSaved) {
            variants = JSON.parse(rawSaved);
        }
    } catch(e) {
        variants = [];
    }

    if (!Array.isArray(variants) || variants.length === 0) {
        variants = [{
            name: PRESETS.dewasa_pendek.name,
            qty_xs: <%= order.size_xs || "''" %>,
            qty_s: <%= order.size_s || "''" %>,
            qty_m: <%= order.size_m || "''" %>,
            qty_l: <%= order.size_l || "''" %>,
            qty_xl: <%= order.size_xl || "''" %>,
            qty_2xl: <%= order.size_2xl || "''" %>,
            qty_3xl: <%= order.size_3xl || "''" %>,
            qty_4xl: <%= order.size_4xl || "''" %>,
            qty_5xl: <%= order.size_5xl || "''" %>
        }];
    }

    function syncCheckboxesWithVariants() {
        Object.keys(PRESETS).forEach(key => {
            const presetName = PRESETS[key].name.toLowerCase();
            const isChecked = variants.some(v => (v.name || '').toLowerCase() === presetName);
            const chk = document.getElementById('chk_' + key);
            const lbl = document.getElementById('label_' + key);
            if (chk) chk.checked = isChecked;
            if (lbl) {
                if (isChecked) {
                    lbl.classList.add('border-blue-400', 'ring-2', 'ring-blue-400', 'bg-blue-50/40');
                    lbl.classList.remove('border-slate-300', 'bg-white');
                } else {
                    lbl.classList.remove('border-blue-400', 'ring-2', 'ring-blue-400', 'bg-blue-50/40');
                    lbl.classList.add('border-slate-300', 'bg-white');
                }
            }
        });
    }

    function handlePresetCheck(presetKey, isChecked) {
        const preset = PRESETS[presetKey];
        if (!preset) return;

        if (isChecked) {
            const exists = variants.some(v => (v.name || '').toLowerCase() === preset.name.toLowerCase());
            if (!exists) {
                variants.push({
                    name: preset.name,
                    qty_xs: '', qty_s: '', qty_m: '', qty_l: '', qty_xl: '',
                    qty_2xl: '', qty_3xl: '', qty_4xl: '', qty_5xl: ''
                });
            }
        } else {
            variants = variants.filter(v => (v.name || '').toLowerCase() !== preset.name.toLowerCase());
        }

        renderVariants();
    }

    function addCustomVariantRow() {
        const customName = prompt('Masukkan nama varian khusus / model lain:', 'Kaos Raglan');
        if (customName && customName.trim()) {
            variants.push({
                name: customName.trim(),
                qty_xs: '', qty_s: '', qty_m: '', qty_l: '', qty_xl: '',
                qty_2xl: '', qty_3xl: '', qty_4xl: '', qty_5xl: ''
            });
            renderVariants();
        }
    }

    function removeCustomVariantRow(idx) {
        if (variants[idx]) {
            variants.splice(idx, 1);
            renderVariants();
        }
    }

    function updateCustomVariantName(idx, val) {
        if (variants[idx]) {
            variants[idx].name = val;
            syncHiddenInputs();
        }
    }

    function clearVariantRow(idx) {
        if (variants[idx]) {
            ['xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl'].forEach(sz => {
                variants[idx]['qty_' + sz] = '';
            });
            renderVariants();
        }
    }

    function updateVariantQty(idx, size, val) {
        if (variants[idx]) {
            variants[idx]['qty_' + size] = val === '' ? '' : parseInt(val) || 0;
            const card = document.querySelector(`.variant-card[data-index="${idx}"]`);
            if (card) {
                const subtotal = ['xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl']
                    .reduce((acc, sz) => acc + (parseInt(variants[idx]['qty_' + sz]) || 0), 0);
                const subtotalEl = card.querySelector('.variant-subtotal');
                if (subtotalEl) subtotalEl.textContent = subtotal;
            }
            recalculateTotals();
        }
    }

    function recalculateTotals() {
        const totals = { xs: 0, s: 0, m: 0, l: 0, xl: 0, '2xl': 0, '3xl': 0, '4xl': 0, '5xl': 0 };
        let grandTotal = 0;

        variants.forEach(v => {
            Object.keys(totals).forEach(sz => {
                const q = parseInt(v['qty_' + sz]) || 0;
                totals[sz] += q;
                grandTotal += q;
            });
        });

        Object.keys(totals).forEach(sz => {
            const hid = document.getElementById('sum_size_' + sz);
            if (hid) hid.value = totals[sz];
        });

        const totalPcsHid = document.getElementById('sum_total_pcs');
        if (totalPcsHid) totalPcsHid.value = grandTotal;

        const disp = document.getElementById('displayTotalPcs');
        if (disp) disp.textContent = grandTotal;

        const diffBox = document.getElementById('diffAlertBox');
        const diffText = document.getElementById('diffAlertText');
        if (diffBox && diffText) {
            const diff = grandTotal - originalTotalPcs;
            if (diff > 0) {
                diffText.textContent = `⚠️ Perhatian: Anda MENAMBAH total sebanyak +${diff} pcs (Total lama: ${originalTotalPcs} pcs &rarr; Baru: ${grandTotal} pcs).`;
                diffBox.classList.remove('hidden');
            } else if (diff < 0) {
                diffText.textContent = `⚠️ Perhatian: Anda MENGURANGI total sebanyak ${diff} pcs (Total lama: ${originalTotalPcs} pcs &rarr; Baru: ${grandTotal} pcs).`;
                diffBox.classList.remove('hidden');
            } else {
                diffBox.classList.add('hidden');
            }
        }

        syncHiddenInputs();
    }

    function syncHiddenInputs() {
        const jsonInput = document.getElementById('items_breakdown_json');
        if (jsonInput) {
            jsonInput.value = JSON.stringify(variants);
        }
    }

    function renderVariants() {
        const container = document.getElementById('variantCardsContainer');
        if (!container) return;
        container.innerHTML = '';

        if (variants.length === 0) {
            container.innerHTML = `
                <div class="p-6 text-center bg-slate-50 border border-dashed border-slate-300 rounded-2xl">
                    <p class="text-xs font-bold text-slate-500">Belum ada model dipilih.</p>
                    <p class="text-[11px] text-slate-400 mt-1">Silakan centang salah satu pilihan model di atas (Dewasa / Anak-Anak, Pendek / Panjang).</p>
                </div>
            `;
            recalculateTotals();
            syncCheckboxesWithVariants();
            return;
        }

        variants.forEach((v, idx) => {
            const presetKey = Object.keys(PRESETS).find(k => PRESETS[k].name.toLowerCase() === (v.name || '').toLowerCase());
            const preset = presetKey ? PRESETS[presetKey] : null;

            const card = document.createElement('div');
            card.className = 'p-3.5 sm:p-4 bg-white border border-slate-200/90 rounded-2xl space-y-3 variant-card shadow-xs transition';
            card.dataset.index = idx;

            const subtotal = ['xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl']
                .reduce((acc, sz) => acc + (parseInt(v['qty_' + sz]) || 0), 0);

            const isKids = (v.name || '').toLowerCase().includes('anak');

            card.innerHTML = `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 border-b border-slate-100">
                    <div class="flex items-center space-x-2">
                        <span class="w-6 h-6 rounded-lg bg-slate-900 text-white font-black text-xs flex items-center justify-center shrink-0 shadow-2xs">
                            ${idx + 1}
                        </span>
                        ${preset ? `
                        <span class="px-3 py-1 rounded-xl text-xs font-black uppercase tracking-wide border ${preset.badgeColor} shadow-2xs flex items-center space-x-1.5">
                            <span>${preset.icon}</span>
                            <span>${preset.name}</span>
                        </span>
                        ` : `
                        <div class="flex items-center space-x-2">
                            <input type="text" class="font-bold text-xs px-3 py-1 border border-slate-300 rounded-xl bg-white uppercase focus:ring-2 focus:ring-blue-500 focus:outline-none" 
                                   value="${v.name || ''}" placeholder="Nama Varian Lain..." 
                                   oninput="updateCustomVariantName(${idx}, this.value)">
                            <span class="text-[10px] text-slate-400 italic">(Varian Khusus)</span>
                        </div>
                        `}
                    </div>
                    <div class="flex items-center space-x-2 self-end sm:self-auto">
                        <span class="text-xs font-bold text-slate-600 bg-slate-50 border border-slate-200 px-3 py-1 rounded-xl shadow-2xs">
                            Subtotal: <strong class="text-blue-700 font-mono font-black variant-subtotal">${subtotal}</strong> Pcs
                        </span>
                        ${!preset ? `
                        <button type="button" onclick="removeCustomVariantRow(${idx})" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition cursor-pointer" title="Hapus Baris">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                        ` : `
                        <button type="button" onclick="clearVariantRow(${idx})" class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer" title="Kosongkan Angka">
                            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                        </button>
                        `}
                    </div>
                </div>

                ${isKids ? `
                <div class="text-[10px] font-semibold text-amber-800 bg-amber-50/90 border border-amber-200/90 px-2.5 py-1 rounded-lg flex items-center space-x-1">
                    <i data-lucide="info" class="w-3.5 h-3.5 text-amber-600 shrink-0"></i>
                    <span>Panduan Size Anak: XS (Size 2 / 2-3 th) &bull; S (Size 4 / 4-5 th) &bull; M (Size 6 / 6-7 th) &bull; L (Size 8 / 8-9 th) &bull; XL (Size 10 / 10-11 th) &bull; 2XL (Size 12)</span>
                </div>` : ''}

                <!-- Kolom Input Ukuran XS s/d 5XL -->
                <div class="grid grid-cols-5 sm:grid-cols-9 gap-1.5 sm:gap-2 text-center">
                    ${['xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl'].map(sz => `
                    <div>
                        <span class="text-[10px] font-black text-slate-500 uppercase block mb-1">${sz}</span>
                        <input type="number" min="0" value="${v['qty_' + sz] || ''}" placeholder="0" 
                               class="qty-input w-full p-2 text-center font-black text-xs sm:text-sm border border-slate-300 rounded-xl bg-slate-50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition shadow-2xs" 
                               oninput="updateVariantQty(${idx}, '${sz}', this.value)">
                    </div>`).join('')}
                </div>
            `;
            container.appendChild(card);
        });

        if (window.lucide) {
            lucide.createIcons();
        }

        recalculateTotals();
        syncCheckboxesWithVariants();
    }

    renderVariants();
</script>
</body>
</html>

