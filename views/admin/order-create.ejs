<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0">
        
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <a href="/admin/orders" class="text-xs font-semibold text-slate-500 hover:text-slate-800 flex items-center space-x-1 mb-1">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                    <span>Kembali ke Daftar Pesanan</span>
                </a>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Buat Lembar Kerja / SPK Baru</h1>
                <p class="text-sm text-slate-500">Sistem akan secara otomatis menyusun antrean tahapan divisi sesuai kategori produk</p>
            </div>
        </div>

        <% if (error) { %>
        <div class="mb-6 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-sm flex items-center space-x-2">
            <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 text-rose-500"></i>
            <span><%= error %></span>
        </div>
        <% } %>

        <form action="/admin/orders/new" method="POST" class="space-y-6">
            
            <!-- Banner Nomor PO TRCH -->
            <div class="p-4 bg-gradient-to-r from-amber-100/90 via-amber-50 to-white border-2 border-amber-300 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
                <div class="flex items-center space-x-3">
                    <img src="/images/trch-logo.svg" alt="TRCH Logo" class="h-11 w-auto rounded border border-black shadow-sm bg-black">
                    <div>
                        <h3 class="text-sm font-black uppercase text-slate-950 flex items-center space-x-1.5">
                            <span>TRCH SCREEN PRINTING</span>
                            <span class="text-xs bg-amber-400 text-slate-950 font-bold px-2 py-0.5 rounded-full">PO Baru</span>
                        </h3>
                        <p class="text-xs text-slate-600 mt-0.5">Nomor urut PO otomatis dimulai dari 1. Anda tetap dapat mengedit nomor ini jika diperlukan.</p>
                    </div>
                </div>
                <div class="w-full sm:w-36 bg-white p-2.5 rounded-xl border border-amber-300 shadow-inner text-center">
                    <label class="block text-[10px] font-black uppercase text-amber-900 tracking-wider mb-0.5">NOMOR PO (AUTO)</label>
                    <input type="number" min="1" name="po_number" value="<%= formData.po_number || nextPoNumber || 1 %>" class="w-full text-center text-2xl font-black bg-amber-50/50 border border-amber-400 rounded-lg py-1 text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500">
                </div>
            </div>

            <!-- Section 1: Info Utama & Kategori Produk -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 border-b border-slate-100 pb-3">
                    <i data-lucide="file-text" class="w-4 h-4 text-blue-600"></i>
                    <span>1. Informasi Pelanggan & Kategori Produk</span>
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Pelanggan / Institusi *</label>
                        <input type="text" name="customer_name" required value="<%= formData.customer_name || '' %>" placeholder="Contoh: ANGGA / Komunitas SGRT" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nomor WhatsApp / HP</label>
                        <input type="text" name="customer_phone" value="<%= formData.customer_phone || '' %>" placeholder="Contoh: 081514418116" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Alamat Pelanggan (Untuk Nota)</label>
                        <input type="text" name="customer_address" value="<%= formData.customer_address || '' %>" placeholder="Contoh: Sumelang, Gemeksekti, Kebumen" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Artikel / Desain Produk *</label>
                        <input type="text" name="article_name" required value="<%= formData.article_name || '' %>" placeholder="Contoh: SGRT GARAGE KAOS OBLONG" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>

                    <!-- Kategori Produk Radio Buttons -->
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Kategori Produk & Alur Kerja *</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            
                            <!-- Opsi Kaos -->
                            <label class="relative flex flex-col p-4 border rounded-2xl cursor-pointer transition hover:bg-slate-50 <%= formData.category === 'kaos' || !formData.category ? 'border-emerald-500 bg-emerald-50/30' : 'border-slate-200' %>">
                                <div class="flex items-center space-x-3">
                                    <input type="radio" name="category" value="kaos" <%= formData.category === 'kaos' || !formData.category ? 'checked' : '' %> class="w-4 h-4 text-emerald-600 focus:ring-emerald-500">
                                    <span class="font-bold text-slate-900 text-sm">Kaos (T-Shirt / Polo / Raglan)</span>
                                </div>
                                <div class="mt-2 text-xs text-slate-500 pl-7 space-y-1">
                                    <p class="font-semibold text-emerald-700">7 Tahapan Produksi:</p>
                                    <p class="text-[11px] leading-relaxed">Desain &rarr; Sekrining/Film &rarr; Potong &rarr; Sablon &rarr; Jahit &rarr; QC & Packing &rarr; Kirim</p>
                                </div>
                            </label>

                            <!-- Opsi Jersey -->
                            <label class="relative flex flex-col p-4 border rounded-2xl cursor-pointer transition hover:bg-slate-50 <%= formData.category === 'jersey' ? 'border-indigo-500 bg-indigo-50/30' : 'border-slate-200' %>">
                                <div class="flex items-center space-x-3">
                                    <input type="radio" name="category" value="jersey" <%= formData.category === 'jersey' ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 focus:ring-indigo-500">
                                    <span class="font-bold text-slate-900 text-sm">Jersey (Full Print / Sublimasi)</span>
                                </div>
                                <div class="mt-2 text-xs text-slate-500 pl-7 space-y-1">
                                    <p class="font-semibold text-indigo-700">6 Tahapan Produksi:</p>
                                    <p class="text-[11px] leading-relaxed">Desain Mockup &rarr; Setting Sublim &rarr; Potong &rarr; Jahit &rarr; QC & Packing &rarr; Kirim</p>
                                </div>
                            </label>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Spesifikasi Lembar POK TRCH -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 border-b border-slate-100 pb-3">
                    <i data-lucide="layers" class="w-4 h-4 text-amber-600"></i>
                    <span>2. Spesifikasi POK (Bahan, Tinta, Finishing & Tanggal)</span>
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tanggal Masuk (TGL M) *</label>
                        <input type="date" name="tgl_masuk" required value="<%= formData.tgl_masuk || '' %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tanggal Jadi (TGL J / Deadline) *</label>
                        <input type="date" name="tgl_jadi" required value="<%= formData.tgl_jadi || formData.deadline_date || '' %>" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Bahan Kain (KETERANGAN)</label>
                        <input type="text" name="fabric_type" value="<%= formData.fabric_type || 'COMBED 24S' %>" placeholder="Contoh: COMBED 24S / COMBED 30S" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Jenis Tinta Sablon</label>
                        <input type="text" name="tinta_type" value="<%= formData.tinta_type || 'PLASTISOL' %>" placeholder="Contoh: PLASTISOL / DISCHARGE / SUBLIM" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Finishing Sablon</label>
                        <input type="text" name="finishing_type" value="<%= formData.finishing_type || 'PRES DOFT' %>" placeholder="Contoh: PRES DOFT / PRES GLOSSY" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Warna Kaos</label>
                        <input type="text" name="warna_kaos" value="<%= formData.warna_kaos || 'HITAM, PUTIH' %>" placeholder="Contoh: HITAM, PUTIH" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>

                    <!-- Pilihan Palet & Roda Warna Tinta Sablon (Depan & Belakang) -->
                    <div class="sm:col-span-2 md:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-4 p-4 bg-slate-50/90 rounded-2xl border border-slate-200">
                        
                        <!-- Sablon Bagian Depan -->
                        <div class="space-y-2.5">
                            <div class="flex items-center justify-between">
                                <label class="block text-xs font-black text-slate-900 uppercase tracking-wider flex items-center space-x-1.5">
                                    <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                                    <span>Warna Sablon Depan</span>
                                </label>
                                <!-- Tombol Roda Warna Depan -->
                                <label class="cursor-pointer inline-flex items-center space-x-1 px-2.5 py-1 bg-gradient-to-r from-red-500 via-amber-400 to-purple-600 hover:opacity-90 text-white rounded-lg text-[11px] font-black shadow-xs transition select-none">
                                    <i data-lucide="disc" class="w-3 h-3 text-white"></i>
                                    <span>+ Roda Warna</span>
                                    <input type="color" onchange="addColorFromWheel('depan', this.value)" class="sr-only">
                                </label>
                            </div>

                            <!-- Palet Warna Cepat Populer (1-Tap Presets) -->
                            <div class="p-2.5 bg-white border border-slate-200 rounded-xl space-y-1.5">
                                <span class="text-[10px] font-bold text-slate-400 block uppercase">Palet Warna Cepat:</span>
                                <div class="flex flex-wrap gap-1.5" id="presets_depan">
                                    <!-- Diisi secara dinamis oleh JavaScript -->
                                </div>
                            </div>

                            <!-- Warna Terpilih Depan -->
                            <div>
                                <span class="text-[10px] font-bold text-slate-500 block uppercase mb-1">Warna Terpilih (Akan Muncul di POK):</span>
                                <div id="selected_depan" class="min-h-[38px] p-2 bg-white border border-dashed border-slate-300 rounded-xl flex flex-wrap gap-1.5 items-center">
                                    <span class="text-[11px] text-slate-400 italic">Belum ada warna dipilih</span>
                                </div>
                                <input type="hidden" name="warna_sablon_depan" id="input_warna_depan" value="<%= formData.warna_sablon_depan || '' %>">
                            </div>
                        </div>

                        <!-- Sablon Bagian Belakang -->
                        <div class="space-y-2.5">
                            <div class="flex items-center justify-between">
                                <label class="block text-xs font-black text-slate-900 uppercase tracking-wider flex items-center space-x-1.5">
                                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                                    <span>Warna Sablon Belakang</span>
                                </label>
                                <!-- Tombol Roda Warna Belakang -->
                                <label class="cursor-pointer inline-flex items-center space-x-1 px-2.5 py-1 bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-600 hover:opacity-90 text-white rounded-lg text-[11px] font-black shadow-xs transition select-none">
                                    <i data-lucide="disc" class="w-3 h-3 text-white"></i>
                                    <span>+ Roda Warna</span>
                                    <input type="color" onchange="addColorFromWheel('belakang', this.value)" class="sr-only">
                                </label>
                            </div>

                            <!-- Palet Warna Cepat Populer (1-Tap Presets) -->
                            <div class="p-2.5 bg-white border border-slate-200 rounded-xl space-y-1.5">
                                <span class="text-[10px] font-bold text-slate-400 block uppercase">Palet Warna Cepat:</span>
                                <div class="flex flex-wrap gap-1.5" id="presets_belakang">
                                    <!-- Diisi secara dinamis oleh JavaScript -->
                                </div>
                            </div>

                            <!-- Warna Terpilih Belakang -->
                            <div>
                                <span class="text-[10px] font-bold text-slate-500 block uppercase mb-1">Warna Terpilih (Akan Muncul di POK):</span>
                                <div id="selected_belakang" class="min-h-[38px] p-2 bg-white border border-dashed border-slate-300 rounded-xl flex flex-wrap gap-1.5 items-center">
                                    <span class="text-[11px] text-slate-400 italic">Belum ada warna dipilih</span>
                                </div>
                                <input type="hidden" name="warna_sablon_belakang" id="input_warna_belakang" value="<%= formData.warna_sablon_belakang || '' %>">
                            </div>
                        </div>

                    </div>

                    <div class="sm:col-span-2 md:col-span-3">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Metode Pengiriman / Ekspedisi</label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
                            <% ['TUNAI', 'DFOD', 'J&T CARGO', 'J&T EXPRESS', 'KAI Logistik', 'KIB CEPAT'].forEach((courier) => { %>
                            <label class="flex items-center space-x-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-slate-50 text-xs font-bold text-slate-800">
                                <input type="radio" name="shipping_courier" value="<%= courier %>" <%= (formData.shipping_courier || 'TUNAI') === courier ? 'checked' : '' %> class="text-amber-600 focus:ring-amber-500">
                                <span><%= courier %></span>
                            </label>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Upload Mockup Desain Kaos (Opsi 1 & Opsi 2) -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
                    <div>
                        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2">
                            <i data-lucide="image" class="w-4 h-4 text-purple-600"></i>
                            <span>3. Upload Desain / Mockup Kaos (Opsi 1 &amp; Opsi 2)</span>
                        </h2>
                        <p class="text-[11px] text-slate-500 mt-0.5">Setiap opsi memuat tampak depan &amp; tampak belakang sekaligus dalam satu gambar.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <!-- Mockup Opsi 1 (Depan & Belakang) -->
                    <div class="p-4 border-2 border-dashed border-slate-200 rounded-2xl text-center space-y-3 bg-slate-50/50 hover:border-purple-300 transition">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-purple-100 text-purple-800">OPSI 1</span>
                            <span class="text-[11px] font-bold text-slate-600">Tampak Depan &amp; Belakang</span>
                        </div>
                        <div id="previewFrontContainer" class="w-full h-48 bg-white rounded-xl border border-slate-200 flex items-center justify-center overflow-hidden">
                            <% if (formData.mockup_front_url) { %>
                                <img src="<%= formData.mockup_front_url %>" alt="Mockup Opsi 1" class="w-full h-full object-contain p-1 rounded-lg">
                            <% } else { %>
                                <span class="text-xs text-slate-400 flex flex-col items-center">
                                    <div class="flex items-center space-x-1 mb-1 text-slate-300">
                                        <i data-lucide="shirt" class="w-7 h-7"></i>
                                        <i data-lucide="shirt" class="w-7 h-7"></i>
                                    </div>
                                    <span class="font-semibold text-slate-500">Preview Opsi 1</span>
                                    <span class="text-[10px] text-slate-400">(Tampak Depan &amp; Belakang)</span>
                                </span>
                            <% } %>
                        </div>
                        <input type="file" id="frontFileInput" accept="image/*" class="text-xs text-slate-600 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-purple-100 file:text-purple-700 hover:file:bg-purple-200 cursor-pointer w-full">
                        <input type="hidden" name="mockup_front_url" id="mockupFrontInput" value="<%= formData.mockup_front_url || '' %>">
                    </div>

                    <!-- Mockup Opsi 2 (Depan & Belakang) -->
                    <div class="p-4 border-2 border-dashed border-slate-200 rounded-2xl text-center space-y-3 bg-slate-50/50 hover:border-purple-300 transition">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-800">OPSI 2</span>
                            <span class="text-[11px] font-bold text-slate-600">Tampak Depan &amp; Belakang</span>
                        </div>
                        <div id="previewBackContainer" class="w-full h-48 bg-white rounded-xl border border-slate-200 flex items-center justify-center overflow-hidden">
                            <% if (formData.mockup_back_url) { %>
                                <img src="<%= formData.mockup_back_url %>" alt="Mockup Opsi 2" class="w-full h-full object-contain p-1 rounded-lg">
                            <% } else { %>
                                <span class="text-xs text-slate-400 flex flex-col items-center">
                                    <div class="flex items-center space-x-1 mb-1 text-slate-300">
                                        <i data-lucide="shirt" class="w-7 h-7"></i>
                                        <i data-lucide="shirt" class="w-7 h-7"></i>
                                    </div>
                                    <span class="font-semibold text-slate-500">Preview Opsi 2</span>
                                    <span class="text-[10px] text-slate-400">(Tampak Depan &amp; Belakang)</span>
                                </span>
                            <% } %>
                        </div>
                        <input type="file" id="backFileInput" accept="image/*" class="text-xs text-slate-600 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-indigo-100 file:text-indigo-700 hover:file:bg-indigo-200 cursor-pointer w-full">
                        <input type="hidden" name="mockup_back_url" id="mockupBackInput" value="<%= formData.mockup_back_url || '' %>">
                    </div>
                </div>
            </div>

            <!-- Section 4: Rincian Ukuran / Size Breakdown -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2">
                        <i data-lucide="ruler" class="w-4 h-4 text-blue-600"></i>
                        <span>4. Rincian Ukuran (Size Breakdown)</span>
                    </h2>
                    <div class="text-xs font-bold text-blue-700 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
                        Total: <span id="displayTotalPcs" class="text-sm font-black">0</span> Pcs
                    </div>
                </div>

                <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-2.5">
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">XS</label>
                        <input type="number" min="0" name="size_xs" value="<%= formData.size_xs || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">S</label>
                        <input type="number" min="0" name="size_s" value="<%= formData.size_s || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">M</label>
                        <input type="number" min="0" name="size_m" value="<%= formData.size_m || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">L</label>
                        <input type="number" min="0" name="size_l" value="<%= formData.size_l || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">XL</label>
                        <input type="number" min="0" name="size_xl" value="<%= formData.size_xl || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">2XL</label>
                        <input type="number" min="0" name="size_2xl" value="<%= formData.size_2xl || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">3XL</label>
                        <input type="number" min="0" name="size_3xl" value="<%= formData.size_3xl || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">4XL</label>
                        <input type="number" min="0" name="size_4xl" value="<%= formData.size_4xl || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-center text-xs font-bold text-slate-600 uppercase mb-1">5XL</label>
                        <input type="number" min="0" name="size_5xl" value="<%= formData.size_5xl || 0 %>" class="size-input text-center font-bold w-full px-2 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                </div>
            </div>

            <!-- Section 5: Instruksi & Catatan Khusus -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 border-b border-slate-100 pb-3">
                    <i data-lucide="clipboard" class="w-4 h-4 text-slate-600"></i>
                    <span>5. Catatan Khusus POK &amp; Nota</span>
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nomor SPK Internal (Opsional)</label>
                        <input type="text" name="order_number" value="<%= formData.order_number || '' %>" placeholder="Auto: SPK-YYYYMM-XXX" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Jumlah Free Pcs (Bonus)</label>
                        <input type="number" min="0" name="free_qty" value="<%= formData.free_qty || 0 %>" placeholder="0" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Catatan Produksi / Finishing</label>
                        <textarea name="notes" rows="3" placeholder="Contoh: Jahitan pundak rantai, lipat dan plastik OPP per pcs, tag leher TRCH..." class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= formData.notes || '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Tombol Aksi Simpan -->
            <div class="flex items-center justify-end space-x-3 pt-2">
                <a href="/admin/orders" class="px-5 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
                    Batal
                </a>
                <button type="submit" class="inline-flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-2.5 rounded-xl text-sm shadow-lg shadow-blue-500/20 transition">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Terbitkan SPK & Buat Alur Antrean</span>
                </button>
            </div>

        </form>

    </main>
</div>

<%- include('../partials/mobile-nav') %>

<script>
    // Live Auto Sum Total Pcs
    function updateTotalPcs() {
        const inputs = document.querySelectorAll('.size-input');
        let total = 0;
        inputs.forEach(input => {
            total += parseInt(input.value) || 0;
        });
        document.getElementById('displayTotalPcs').textContent = total;
    }

    document.querySelectorAll('.size-input').forEach(input => {
        input.addEventListener('input', updateTotalPcs);
    });

    updateTotalPcs();

    // Image Upload Handlers for Mockups
    function setupImageUpload(fileInputId, hiddenInputId, containerId) {
        const fileInput = document.getElementById(fileInputId);
        const hiddenInput = document.getElementById(hiddenInputId);
        const container = document.getElementById(containerId);

        if (!fileInput || !hiddenInput || !container) return;

        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const base64Data = e.target.result;
                hiddenInput.value = base64Data;
                container.innerHTML = `<img src="${base64Data}" alt="Mockup" class="w-full h-full object-contain p-1 rounded-lg">`;
            };
            reader.readAsDataURL(file);
        });
    }

    setupImageUpload('frontFileInput', 'mockupFrontInput', 'previewFrontContainer');
    setupImageUpload('backFileInput', 'mockupBackInput', 'previewBackContainer');

    // Palet Warna & Roda Warna Sablon Interaktif
    const COLOR_PRESETS = [
        { name: 'Hitam', hex: '#000000', border: false },
        { name: 'Putih', hex: '#ffffff', border: true },
        { name: 'Merah', hex: '#ef4444', border: false },
        { name: 'Kuning', hex: '#eab308', border: false },
        { name: 'Hijau', hex: '#84cc16', border: false },
        { name: 'Navy', hex: '#1e3a8a', border: false },
        { name: 'Biru', hex: '#0284c7', border: false },
        { name: 'Oranye', hex: '#ea580c', border: false },
        { name: 'Abu-abu', hex: '#64748b', border: false },
        { name: 'Gold', hex: '#d97706', border: false }
    ];

    const selectedSablonColors = {
        depan: [],
        belakang: []
    };

    function initColorPalettes() {
        ['depan', 'belakang'].forEach(side => {
            const container = document.getElementById('presets_' + side);
            if (!container) return;
            container.innerHTML = '';
            COLOR_PRESETS.forEach(p => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'inline-flex items-center space-x-1 px-2 py-1 bg-slate-50 hover:bg-slate-100 border border-slate-300 rounded-lg text-[11px] font-bold text-slate-700 transition cursor-pointer select-none';
                btn.innerHTML = `
                    <span class="w-3 h-3 rounded-full inline-block shrink-0 ${p.border ? 'border border-slate-400' : ''}" style="background-color: ${p.hex};"></span>
                    <span>${p.name}</span>
                `;
                btn.onclick = () => togglePresetColor(side, p.hex, p.name);
                container.appendChild(btn);
            });

            // Parse initial value jika ada
            const initialInput = document.getElementById('input_warna_' + side);
            if (initialInput && initialInput.value) {
                const vals = initialInput.value.split(',').map(s => s.trim()).filter(Boolean);
                vals.forEach(v => {
                    const presetMatch = COLOR_PRESETS.find(p => p.name.toLowerCase() === v.toLowerCase() || p.hex.toLowerCase() === v.toLowerCase());
                    if (presetMatch) {
                        selectedSablonColors[side].push({ hex: presetMatch.hex, name: presetMatch.name });
                    } else {
                        selectedSablonColors[side].push({ hex: v.startsWith('#') ? v : '#' + v, name: v.toUpperCase() });
                    }
                });
            }
            renderSelectedColors(side);
        });
    }

    function togglePresetColor(side, hex, name) {
        const idx = selectedSablonColors[side].findIndex(c => c.hex.toLowerCase() === hex.toLowerCase());
        if (idx >= 0) {
            selectedSablonColors[side].splice(idx, 1);
        } else {
            selectedSablonColors[side].push({ hex, name });
        }
        renderSelectedColors(side);
    }

    function addColorFromWheel(side, hex) {
        if (!hex) return;
        const presetMatch = COLOR_PRESETS.find(p => p.hex.toLowerCase() === hex.toLowerCase());
        const name = presetMatch ? presetMatch.name : hex.toUpperCase();
        if (!selectedSablonColors[side].some(c => c.hex.toLowerCase() === hex.toLowerCase())) {
            selectedSablonColors[side].push({ hex, name });
        }
        renderSelectedColors(side);
    }

    function removeSelectedColor(side, idx) {
        selectedSablonColors[side].splice(idx, 1);
        renderSelectedColors(side);
    }

    function renderSelectedColors(side) {
        const container = document.getElementById('selected_' + side);
        const hiddenInput = document.getElementById('input_warna_' + side);
        if (!container || !hiddenInput) return;

        hiddenInput.value = selectedSablonColors[side].map(c => c.hex).join(',');

        if (selectedSablonColors[side].length === 0) {
            container.innerHTML = '<span class="text-[11px] text-slate-400 italic">Belum ada warna dipilih (klik palet di atas atau roda warna)</span>';
            return;
        }

        let html = '';
        selectedSablonColors[side].forEach((c, idx) => {
            html += `
            <span class="inline-flex items-center space-x-1.5 pl-2 pr-1.5 py-1 rounded-lg text-xs font-bold border border-slate-300 bg-white shadow-xs">
                <span class="w-3.5 h-3.5 rounded-sm border border-black inline-block shrink-0" style="background-color: ${c.hex};"></span>
                <span class="text-slate-800">${c.name}</span>
                <button type="button" onclick="removeSelectedColor('${side}', ${idx})" class="w-4 h-4 rounded-full hover:bg-rose-100 hover:text-rose-600 text-slate-400 flex items-center justify-center font-bold text-xs leading-none ml-1 cursor-pointer">&times;</button>
            </span>
            `;
        });
        container.innerHTML = html;
    }

    initColorPalettes();

    if (window.lucide) {
        lucide.createIcons();
    }
</script>
</body>
</html>

