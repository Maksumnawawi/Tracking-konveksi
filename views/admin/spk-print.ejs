<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak SPK - <%= order.order_number %></title>
    
    <!-- Tailwind CSS CDN (untuk preview layar) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Print Optimized CSS -->
    <link rel="stylesheet" href="/css/print-spk.css">

    <style>
        /* Tampilan simulasi kertas A4 pada layar monitor */
        @media screen {
            body {
                background-color: #525659;
                padding: 24px;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            .a4-page {
                background: white;
                width: 210mm;
                min-height: 297mm;
                padding: 12mm 15mm;
                box-shadow: 0 4px 20px rgba(0,0,0,0.3);
                border-radius: 4px;
            }
        }
    </style>
</head>
<body>

    <!-- Floating Print Control Toolbar (Hanya muncul di layar monitor) -->
    <div class="no-print w-full max-w-[210mm] mb-4 flex items-center justify-between bg-slate-900 text-white px-5 py-3 rounded-xl shadow-lg">
        <div class="flex items-center space-x-3">
            <a href="/admin/orders/<%= order.id %>" class="text-xs text-slate-300 hover:text-white flex items-center space-x-1">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                <span>Kembali ke Detail</span>
            </a>
            <span class="text-slate-500">|</span>
            <span class="text-xs font-semibold text-slate-200">Pratinjau Lembar Kerja Fisik (A4)</span>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-4 py-2 rounded-lg text-xs flex items-center space-x-2 shadow-md">
                <i data-lucide="printer" class="w-4 h-4"></i>
                <span>Cetak Lembar Kerja A4 (Print)</span>
            </button>
        </div>
    </div>

    <!-- Halaman Fisik Standar A4 -->
    <div class="a4-page spk-container text-slate-900 font-sans">
        
        <!-- Header SPK -->
        <div class="spk-header border-b-2 border-black pb-3 mb-3 flex items-start justify-between">
            <div>
                <div class="flex items-center space-x-2">
                    <span class="text-xl font-black tracking-tight">GARMENT & APPAREL PRODUCTION</span>
                </div>
                <p class="text-xs font-semibold tracking-wide text-slate-700">LEMBAR KERJA FISIK PRODUKSI (SPK)</p>
                <p class="text-[10px] text-slate-500">Divisi Konveksi, Sablon & Sublimasi Jersey</p>
            </div>
            <div class="text-right flex items-center space-x-4">
                <div>
                    <span class="text-[10px] uppercase font-bold text-slate-500 block">Nomor SPK</span>
                    <span class="text-lg font-black font-mono tracking-tight text-black block leading-none"><%= order.order_number %></span>
                    <span class="text-[10px] font-bold text-blue-700 block mt-1">Kode: <%= order.tracking_code %></span>
                </div>
                <!-- QR Code untuk Tracking Publik Cepat -->
                <% if (qrCodeDataUrl) { %>
                <div class="text-center">
                    <img src="<%= qrCodeDataUrl %>" alt="QR Tracking" class="qr-code w-16 h-16 border border-slate-300 p-0.5">
                    <span class="text-[8px] text-slate-500 block mt-0.5">Scan Tracking</span>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Info Order Grid -->
        <div class="grid grid-cols-2 gap-2 text-xs mb-3 border border-slate-800 p-2.5 rounded bg-slate-50/50">
            <div>
                <table class="w-full text-left">
                    <tr>
                        <td class="w-28 font-bold py-0.5 text-slate-600">Pelanggan:</td>
                        <td class="font-bold py-0.5 text-slate-900"><%= order.customer_name %></td>
                    </tr>
                    <tr>
                        <td class="font-bold py-0.5 text-slate-600">Kontak/HP:</td>
                        <td class="py-0.5"><%= order.customer_phone || '-' %></td>
                    </tr>
                    <tr>
                        <td class="font-bold py-0.5 text-slate-600">Nama Artikel:</td>
                        <td class="font-bold py-0.5 text-slate-900"><%= order.article_name %></td>
                    </tr>
                </table>
            </div>
            <div>
                <table class="w-full text-left">
                    <tr>
                        <td class="w-28 font-bold py-0.5 text-slate-600">Kategori:</td>
                        <td class="font-bold py-0.5 uppercase text-black"><%= order.category %></td>
                    </tr>
                    <tr>
                        <td class="font-bold py-0.5 text-slate-600">Tgl Cetak SPK:</td>
                        <td class="py-0.5"><%= printDate %></td>
                    </tr>
                    <tr>
                        <td class="font-bold py-0.5 text-slate-600">DEADLINE:</td>
                        <td class="font-black py-0.5 text-red-600 text-sm"><%= order.deadline_date || '-' %></td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Tabel Rincian Ukuran / Size Breakdown -->
        <div class="mb-3">
            <p class="text-[11px] font-bold uppercase tracking-wider text-black mb-1">1. RINCIAN UKURAN (SIZE BREAKDOWN)</p>
            <table class="w-full text-center border-collapse border border-black text-xs">
                <thead>
                    <tr class="bg-slate-100 font-bold border-b border-black">
                        <th class="border border-black py-1">XS</th>
                        <th class="border border-black py-1">S</th>
                        <th class="border border-black py-1">M</th>
                        <th class="border border-black py-1">L</th>
                        <th class="border border-black py-1">XL</th>
                        <th class="border border-black py-1">2XL</th>
                        <th class="border border-black py-1">3XL</th>
                        <th class="border border-black py-1 bg-slate-200 text-black">TOTAL QTY</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="font-bold text-sm">
                        <td class="border border-black py-1.5"><%= order.size_xs || '-' %></td>
                        <td class="border border-black py-1.5"><%= order.size_s || '-' %></td>
                        <td class="border border-black py-1.5"><%= order.size_m || '-' %></td>
                        <td class="border border-black py-1.5"><%= order.size_l || '-' %></td>
                        <td class="border border-black py-1.5"><%= order.size_xl || '-' %></td>
                        <td class="border border-black py-1.5"><%= order.size_2xl || '-' %></td>
                        <td class="border border-black py-1.5"><%= order.size_3xl || '-' %></td>
                        <td class="border border-black py-1.5 font-black text-base bg-slate-100"><%= order.total_pcs %> Pcs</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Bahan & Sablon / Sublim -->
        <div class="grid grid-cols-2 gap-2 text-xs mb-3">
            <div class="border border-black p-2 rounded">
                <span class="font-bold block text-[10px] text-slate-500 uppercase">Spesifikasi Bahan Kain:</span>
                <span class="font-bold text-slate-900 block text-xs mt-0.5"><%= order.fabric_type || 'Sesuai instruksi admin' %></span>
            </div>
            <div class="border border-black p-2 rounded">
                <span class="font-bold block text-[10px] text-slate-500 uppercase">Spesifikasi Cetak / Sablon:</span>
                <span class="font-bold text-slate-900 block text-xs mt-0.5"><%= order.print_type || 'Sesuai mockup desain' %></span>
            </div>
        </div>

        <!-- Catatan Khusus Instruksi Produksi -->
        <div class="border border-black p-2.5 rounded text-xs mb-3">
            <span class="font-bold block text-[10px] text-slate-600 uppercase mb-1">Instruksi Khusus Produksi (Floor Notes):</span>
            <p class="font-medium text-slate-800 italic leading-relaxed">
                <%= order.notes || 'Tidak ada catatan khusus. Kerjakan sesuai standar kualitas konveksi.' %>
            </p>
        </div>

        <!-- Checklist Paraf Tahapan Produksi (Floor Workflow Control) -->
        <div class="mb-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-black mb-1">2. LEMBAR KONTROL & PARAF DIVISI PRODUKSI</p>
            <table class="w-full text-left border-collapse border border-black text-[11px]">
                <thead>
                    <tr class="bg-slate-100 font-bold border-b border-black text-center">
                        <th class="border border-black py-1 w-8">No</th>
                        <th class="border border-black py-1">Tahapan Kerja</th>
                        <th class="border border-black py-1">Divisi PIC</th>
                        <th class="border border-black py-1 w-28">Tgl / Jam Mulai</th>
                        <th class="border border-black py-1 w-28">Tgl / Jam Selesai</th>
                        <th class="border border-black py-1 w-24">Paraf PIC</th>
                        <th class="border border-black py-1">Catatan Lantai</th>
                    </tr>
                </thead>
                <tbody>
                    <% stages.forEach((st, idx) => { %>
                    <tr>
                        <td class="border border-black py-2 text-center font-bold"><%= idx + 1 %></td>
                        <td class="border border-black py-2 font-bold"><%= st.stage_name %></td>
                        <td class="border border-black py-2 font-semibold text-slate-700"><%= ROLE_LABELS[st.assigned_role] || st.assigned_role %></td>
                        <td class="border border-black py-2 text-center text-slate-500">....../...... pkl .....</td>
                        <td class="border border-black py-2 text-center text-slate-500">....../...... pkl .....</td>
                        <td class="border border-black py-2 text-center font-serif text-slate-400">[ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ]</td>
                        <td class="border border-black py-2"></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Area Hasil QC & Tanda Tangan SPV -->
        <div class="avoid-break grid grid-cols-2 gap-3 pt-2 text-xs border-t border-slate-300">
            <div class="border border-black p-2.5 rounded">
                <span class="font-bold block text-[10px] text-slate-600 uppercase mb-1">Rekap Fisik QC & Packing:</span>
                <div class="space-y-1 text-[11px]">
                    <p>Total Diperiksa: ............ Pcs</p>
                    <p>Jumlah Lolos: ................ Pcs &nbsp;&bull;&nbsp; Jumlah Reject: ................ Pcs</p>
                    <p>Paraf QC Inspector: ........................................</p>
                </div>
            </div>

            <div class="flex items-center justify-around text-center pt-2">
                <div>
                    <p class="text-[10px] uppercase font-bold text-slate-500">Dibuat Oleh (Admin):</p>
                    <div class="h-10"></div>
                    <p class="font-bold text-xs underline">( ........................................ )</p>
                </div>
                <div>
                    <p class="text-[10px] uppercase font-bold text-slate-500">Mengetahui (SPV Produksi):</p>
                    <div class="h-10"></div>
                    <p class="font-bold text-xs underline">( ........................................ )</p>
                </div>
            </div>
        </div>

        <!-- Footer Nota -->
        <div class="mt-4 pt-2 border-t border-slate-200 text-center text-[9px] text-slate-400">
            Lembar SPK ini merupakan dokumen instruksi kerja resmi konveksi. Setelah selesai, kembalikan ke meja administrasi. Link pelacakan: <%= publicTrackUrl %>
        </div>

    </div>

    <script>
        if (window.lucide) {
            lucide.createIcons();
        }
    </script>
</body>
</html>

