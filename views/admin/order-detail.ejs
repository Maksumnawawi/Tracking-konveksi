<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
                <a href="/admin/orders" class="text-xs font-semibold text-slate-500 hover:text-slate-800 flex items-center space-x-1 mb-1">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                    <span>Kembali ke Semua Pesanan</span>
                </a>
                <div class="flex items-center space-x-3">
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= order.order_number %></h1>
                    <span class="px-3 py-1 rounded-lg text-xs font-black bg-slate-900 text-white border border-slate-700">
                        PO #<%= order.po_number || order.id %>
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase <%= order.category === 'jersey' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                        <%= order.category %>
                    </span>
                    <% if (order.status === 'COMPLETED') { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Selesai Produksi</span>
                    <% } else if (order.status === 'IN_PROGRESS') { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">Sedang Dikerjakan</span>
                    <% } else if (order.status === 'PAUSED') { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">Dijeda (Paused)</span>
                    <% } else if (order.status === 'CANCELLED') { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">DIBATALKAN</span>
                    <% } else { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">Antrean</span>
                    <% } %>
                </div>
                <p class="text-sm font-semibold text-slate-700 mt-1"><%= order.article_name %> &bull; <span class="font-normal text-slate-500"><%= order.customer_name %></span></p>
            </div>

            <div class="flex items-center flex-wrap gap-2">
                <!-- 2 TOMBOL UTAMA TRCH: NOTA & POK -->
                <a href="/admin/orders/<%= order.id %>/nota" class="inline-flex items-center space-x-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black px-4 py-2.5 rounded-xl text-sm shadow-md shadow-amber-500/20 transition">
                    <i data-lucide="receipt" class="w-4 h-4"></i>
                    <span>🧾 Cek &amp; Edit Nota</span>
                </a>

                <a href="/admin/orders/<%= order.id %>/spk" target="_blank" class="inline-flex items-center space-x-1.5 bg-slate-950 hover:bg-slate-800 text-white font-black px-4 py-2.5 rounded-xl text-sm shadow-md transition">
                    <i data-lucide="printer" class="w-4 h-4"></i>
                    <span>🖨️ Cetak Lembar POK</span>
                </a>

                <% if (order.status !== 'CANCELLED') { %>
                <!-- Tombol Edit Pesanan Khusus Owner -->
                <a href="/admin/orders/<%= order.id %>/edit" class="inline-flex items-center space-x-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-3 py-2 rounded-xl text-xs transition">
                    <i data-lucide="edit" class="w-3.5 h-3.5"></i>
                    <span>Edit Order</span>
                </a>

                <!-- Tombol Batalkan Pesanan -->
                <button type="button" onclick="openCancelModal()" class="inline-flex items-center space-x-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold px-3 py-2 rounded-xl text-xs transition">
                    <i data-lucide="ban" class="w-3.5 h-3.5"></i>
                    <span>Batal</span>
                </button>
                <% } %>

                <a href="/track/<%= order.tracking_code %>" target="_blank" class="inline-flex items-center space-x-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-3 py-2 rounded-xl text-xs transition">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    <span>Tracking</span>
                </a>
            </div>
        </div>

        <!-- Banner Cepat Nota & Keuangan TRCH -->
        <div class="mb-6 p-4 bg-gradient-to-r from-amber-50 via-white to-amber-50/50 border border-amber-200 rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-sm">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400 flex items-center justify-center text-amber-800 font-bold">
                    <i data-lucide="wallet" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-amber-900">Status Keuangan &amp; Nota TRCH</h3>
                    <div class="flex items-center gap-3 mt-0.5 text-xs">
                        <span class="font-bold text-slate-900">Total: Rp <%= (order.total_price || 0).toLocaleString('id-ID') %></span>
                        <span class="text-slate-400">&bull;</span>
                        <span class="font-bold text-emerald-700">DP: Rp <%= (order.down_payment || 0).toLocaleString('id-ID') %></span>
                        <span class="text-slate-400">&bull;</span>
                        <span class="font-black text-rose-600">Sisa: Rp <%= (order.remaining_payment || 0).toLocaleString('id-ID') %></span>
                    </div>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <a href="/admin/orders/<%= order.id %>/nota" class="text-xs font-bold text-amber-900 bg-amber-200/70 hover:bg-amber-300 px-3 py-1.5 rounded-lg transition flex items-center space-x-1">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    <span>Atur Harga / Cek Nota</span>
                </a>
                <a href="/admin/orders/<%= order.id %>/nota/print" target="_blank" class="text-xs font-bold text-slate-800 bg-white border border-slate-300 hover:bg-slate-50 px-3 py-1.5 rounded-lg transition flex items-center space-x-1 shadow-sm">
                    <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                    <span>Cetak Nota</span>
                </a>
            </div>
        </div>

        <% if (successMsg) { %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-sm flex items-center space-x-2">
            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600 shrink-0"></i>
            <span><%= successMsg %></span>
        </div>
        <% } %>

        <% if (errorMsg) { %>
        <div class="mb-6 bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl text-sm flex items-center space-x-2">
            <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 shrink-0"></i>
            <span><%= errorMsg %></span>
        </div>
        <% } %>

        <% if (isCreated) { %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-sm flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                <span>SPK baru berhasil dibuat! Lembar kerja fisik siap dicetak untuk dibawa ke lantai kerja fisik.</span>
            </div>
            <a href="/admin/orders/<%= order.id %>/spk" target="_blank" class="font-bold underline text-emerald-700">Cetak Sekarang &rarr;</a>
        </div>
        <% } %>

        <!-- Grid 3 Kolom Info & Rekap Akhir -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            
            <!-- Kolom 1: Rincian SPK & Ukuran -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-1.5 border-b border-slate-100 pb-2">
                    <i data-lucide="file-text" class="w-3.5 h-3.5 text-blue-600"></i>
                    <span>Spesifikasi Pesanan</span>
                </h2>

                <div class="space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-500">Nomor SPK:</span>
                        <span class="font-mono font-bold text-slate-800"><%= order.order_number %></span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-500">Kode Lacak Publik:</span>
                        <span class="font-mono font-bold text-blue-600"><%= order.tracking_code %></span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-500">Pelanggan:</span>
                        <span class="font-bold text-slate-800"><%= order.customer_name %> (<%= order.customer_phone || '-' %>)</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-500">Jenis Bahan Kain:</span>
                        <span class="font-semibold text-slate-800"><%= order.fabric_type || '-' %></span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-500">Jenis Cetak / Sablon:</span>
                        <span class="font-semibold text-slate-800"><%= order.print_type || '-' %></span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-500">Tenggat Waktu:</span>
                        <span class="font-bold text-rose-600"><%= order.deadline_date || '-' %></span>
                    </div>
                </div>

                <!-- Rincian Size Table -->
                <div class="pt-2">
                    <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Rincian Ukuran &amp; Varian Model</p>
                    
                    <% 
                    let detailVariants = [];
                    try {
                        if (order.items_breakdown_json) detailVariants = JSON.parse(order.items_breakdown_json);
                    } catch(e) {}
                    %>

                    <% if (Array.isArray(detailVariants) && detailVariants.length > 0) { %>
                    <div class="space-y-2 mb-3">
                        <% detailVariants.forEach(v => { 
                            const rowSub = ['xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl'].reduce((acc, sz) => acc + (parseInt(v['qty_' + sz]) || 0), 0);
                        %>
                        <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-xs">
                            <div class="flex items-center justify-between font-bold text-slate-800 mb-1.5">
                                <span class="uppercase text-[11px] text-blue-900 font-black"><%= v.name || 'Varian Kaos' %></span>
                                <span class="text-[11px] bg-white border border-slate-200 px-2 py-0.5 rounded-lg font-mono font-bold text-slate-700 shadow-2xs"><%= rowSub %> Pcs</span>
                            </div>
                            <div class="grid grid-cols-5 sm:grid-cols-9 gap-1 text-center text-[10px]">
                                <% ['xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl'].forEach(sz => { %>
                                <div class="bg-white p-1 rounded-lg border border-slate-200/80 shadow-2xs">
                                    <span class="text-slate-400 block uppercase font-bold"><%= sz %></span>
                                    <span class="font-bold text-[11px] <%= v['qty_' + sz] ? 'text-blue-700 font-mono' : 'text-slate-300' %>"><%= v['qty_' + sz] || '-' %></span>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <div class="grid grid-cols-5 sm:grid-cols-9 gap-1 text-center bg-slate-50 p-2 rounded-xl border border-slate-200">
                        <% [
                            { l: 'XS', v: order.size_xs },
                            { l: 'S', v: order.size_s },
                            { l: 'M', v: order.size_m },
                            { l: 'L', v: order.size_l },
                            { l: 'XL', v: order.size_xl },
                            { l: '2XL', v: order.size_2xl },
                            { l: '3XL', v: order.size_3xl },
                            { l: '4XL', v: order.size_4xl },
                            { l: '5XL', v: order.size_5xl }
                        ].forEach(item => { %>
                        <div class="bg-white p-1 rounded border border-slate-100">
                            <span class="text-[10px] text-slate-400 block font-semibold"><%= item.l %></span>
                            <span class="text-xs font-bold text-slate-800"><%= item.v || 0 %></span>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>

                    <div class="mt-2 text-right text-xs">
                        <span class="text-slate-500">Total Produksi:</span>
                        <span class="font-black text-slate-900 text-sm ml-1"><%= order.total_pcs %> Pcs</span>
                    </div>
                </div>

                <% if (order.notes) { %>
                <div class="pt-2 border-t border-slate-100">
                    <p class="text-[11px] font-bold text-slate-500 uppercase mb-1">Catatan Khusus SPK:</p>
                    <p class="text-xs text-slate-700 bg-amber-50/60 p-2.5 rounded-lg border border-amber-200/60 italic leading-relaxed">
                        "<%= order.notes %>"
                    </p>
                </div>
                <% } %>
            </div>

            <!-- Kolom 2: Rekapitulasi Waktu Bersih Produksi -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-1.5 border-b border-slate-100 pb-2 mb-3">
                        <i data-lucide="timer" class="w-3.5 h-3.5 text-blue-600"></i>
                        <span>Rekapitulasi Durasi Bersih Produksi</span>
                    </h2>

                    <!-- Total Keseluruhan Highlight -->
                    <div class="p-4 bg-blue-50/70 border border-blue-200/80 rounded-2xl mb-4 text-center">
                        <p class="text-xs font-bold text-blue-700 uppercase tracking-wider">Total Waktu Produksi Keseluruhan</p>
                        <p class="text-2xl font-black text-blue-900 mt-1 font-mono">
                            <%= formatDurationClock(grandTotalSeconds) %>
                        </p>
                        <p class="text-xs text-blue-600 font-medium mt-0.5">
                            <%= formatDurationDetailed(grandTotalSeconds) %> (waktu jeda tidak dihitung)
                        </p>
                    </div>

                    <!-- Breakdown per Divisi -->
                    <div class="space-y-2">
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Waktu Pengerjaan per Tahapan:</p>
                        <div class="space-y-1.5 max-h-56 overflow-y-auto pr-1">
                            <% stages.forEach(st => { %>
                            <div class="flex items-center justify-between py-1.5 px-2 rounded-lg bg-slate-50 text-xs border border-slate-100">
                                <div class="flex items-center space-x-2">
                                    <% if (st.status === 'COMPLETED') { %>
                                        <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-500"></i>
                                    <% } else if (st.status === 'IN_PROGRESS') { %>
                                        <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
                                    <% } else if (st.status === 'PAUSED') { %>
                                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                    <% } else { %>
                                        <span class="w-2 h-2 rounded-full bg-slate-300"></span>
                                    <% } %>
                                    <div>
                                        <span class="font-semibold text-slate-800"><%= st.stage_name %></span>
                                        <span class="text-[10px] text-slate-400 block"><%= ROLE_LABELS[st.assigned_role] || st.assigned_role %></span>
                                    </div>
                                </div>
                                <span class="font-mono font-bold <%= st.status === 'IN_PROGRESS' ? 'text-blue-700' : 'text-slate-700' %>">
                                    <%= formatDurationClock(st.currentActiveSeconds) %>
                                </span>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <p class="text-[11px] text-slate-400 pt-3 border-t border-slate-100 mt-4 flex items-center space-x-1">
                    <i data-lucide="info" class="w-3.5 h-3.5 text-blue-500"></i>
                    <span>Akumulasi timer otomatis saat PIC menekan Mulai & Selesai.</span>
                </p>
            </div>

            <!-- Kolom 3: Hasil Inspeksi QC & Mutu -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-1.5 border-b border-slate-100 pb-2 mb-3">
                        <i data-lucide="award" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span>Kalkulasi & Hasil QC & Packing</span>
                    </h2>

                    <% if (qcResult) { %>
                    <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-center mb-4">
                        <p class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Persentase Keberhasilan QC</p>
                        <p class="text-4xl font-black text-emerald-800 mt-1">
                            <%= Number(qcResult.pass_percentage).toFixed(1) %><span class="text-xl font-bold">%</span>
                        </p>
                        <p class="text-xs text-emerald-600 mt-0.5">Inspeksi oleh: <%= qcResult.inspector_name %></p>
                    </div>

                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Total Diperiksa:</span>
                            <span class="font-bold text-slate-800"><%= qcResult.total_checked %> pcs</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Pcs Lolos (Pass):</span>
                            <span class="font-bold text-emerald-700"><%= qcResult.pcs_passed %> pcs</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Pcs Cacat / Reject:</span>
                            <span class="font-bold text-rose-600"><%= qcResult.pcs_reject %> pcs</span>
                        </div>
                    </div>

                    <% if (qcResult.reject_reason) { %>
                    <div class="mt-3 p-2.5 bg-rose-50/70 border border-rose-200 rounded-xl text-xs text-rose-800">
                        <p class="font-bold mb-0.5">Catatan Cacat / Reject:</p>
                        <p class="italic">"<%= qcResult.reject_reason %>"</p>
                        <% if (qcResult.rework_notes) { %>
                        <p class="text-[11px] text-slate-600 mt-1"><strong>Tindakan:</strong> <%= qcResult.rework_notes %></p>
                        <% } %>
                    </div>
                    <% } %>

                    <% } else { %>
                    <div class="py-12 text-center text-slate-400">
                        <i data-lucide="clock" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                        <p class="text-xs">Tahap QC & Packing belum dilaksanakan.</p>
                        <p class="text-[11px] text-slate-400 mt-1">Hasil kalkulasi kelulusan akan muncul setelah PIC QC menyelesaikan inspeksi.</p>
                    </div>
                    <% } %>
                </div>

                <div class="pt-3 border-t border-slate-100 text-[11px] text-slate-400">
                    Formula: (Pcs Lolos / Total Diperiksa) &times; 100%
                </div>
            </div>

        </div>

        <!-- Section Visual Mockup Desain (Opsi 1 & Opsi 2) -->
        <% if (order.mockup_front_url || order.mockup_back_url) { %>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm mb-8">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 mb-4">
                <i data-lucide="image" class="w-4 h-4 text-purple-600"></i>
                <span>Mockup Visual Desain <%= (order.mockup_front_url && order.mockup_back_url) ? '(Opsi 1 & Opsi 2)' : '' %></span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-<%= (order.mockup_front_url && order.mockup_back_url) ? 2 : 1 %> gap-4">
                <% if (order.mockup_front_url) { %>
                <div class="border border-slate-200 rounded-xl p-3 bg-slate-50/50 text-center">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-black uppercase text-purple-800 bg-purple-100 px-2.5 py-0.5 rounded">Desain Opsi 1</span>
                        <span class="text-[11px] font-bold text-slate-500">Tampak Depan &amp; Belakang</span>
                    </div>
                    <div class="w-full h-64 flex items-center justify-center bg-white rounded-lg border border-slate-200 p-2 overflow-hidden">
                        <img src="<%= order.mockup_front_url %>" alt="Desain Opsi 1 (Depan & Belakang)" class="max-h-full max-w-full object-contain">
                    </div>
                </div>
                <% } %>
                <% if (order.mockup_back_url) { %>
                <div class="border border-slate-200 rounded-xl p-3 bg-slate-50/50 text-center">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-black uppercase text-indigo-800 bg-indigo-100 px-2.5 py-0.5 rounded">Desain Opsi 2</span>
                        <span class="text-[11px] font-bold text-slate-500">Tampak Depan &amp; Belakang</span>
                    </div>
                    <div class="w-full h-64 flex items-center justify-center bg-white rounded-lg border border-slate-200 p-2 overflow-hidden">
                        <img src="<%= order.mockup_back_url %>" alt="Desain Opsi 2 (Depan & Belakang)" class="max-h-full max-w-full object-contain">
                    </div>
                </div>
                <% } %>
            </div>
        </div>
        <% } %>

        <!-- Section Timeline Alur Kerja -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm mb-8">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-2 mb-6">
                <i data-lucide="git-commit" class="w-4 h-4 text-blue-600"></i>
                <span>Garis Waktu (Workflow Timeline) Tahapan Divisi</span>
            </h2>

            <div class="relative">
                <!-- Garis horizontal desktop -->
                <div class="hidden md:block absolute top-1/2 left-0 right-0 h-1 bg-slate-200 -translate-y-1/2 z-0"></div>

                <div class="grid grid-cols-1 md:grid-cols-<%= stages.length %> gap-4 relative z-10">
                    <% stages.forEach((st, idx) => { %>
                    <div class="flex md:flex-col items-center md:items-center space-x-4 md:space-x-0 md:text-center bg-white md:bg-transparent p-3 md:p-0 rounded-xl border md:border-0 border-slate-200">
                        
                        <!-- Lingkaran Tahap -->
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs shrink-0 transition shadow-sm
                            <% if (st.status === 'COMPLETED') { %>
                                bg-emerald-600 text-white shadow-emerald-500/20
                            <% } else if (st.status === 'IN_PROGRESS') { %>
                                bg-blue-600 text-white ring-4 ring-blue-100 animate-pulse
                            <% } else if (st.status === 'PAUSED') { %>
                                bg-amber-500 text-white ring-4 ring-amber-100
                            <% } else { %>
                                bg-slate-200 text-slate-500
                            <% } %>
                        ">
                            <% if (st.status === 'COMPLETED') { %>
                                <i data-lucide="check" class="w-5 h-5"></i>
                            <% } else { %>
                                <%= idx + 1 %>
                            <% } %>
                        </div>

                        <!-- Label & Status -->
                        <div class="mt-0 md:mt-2 min-w-0">
                            <p class="font-bold text-slate-800 text-xs md:text-sm truncate"><%= st.stage_name %></p>
                            <p class="text-[10px] text-slate-400 uppercase font-semibold"><%= ROLE_LABELS[st.assigned_role] || st.assigned_role %></p>
                            
                            <div class="mt-1">
                                <% if (st.status === 'COMPLETED') { %>
                                    <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
                                        ✓ <%= formatDurationDetailed(st.total_active_seconds) %>
                                    </span>
                                <% } else if (st.status === 'IN_PROGRESS') { %>
                                    <span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full animate-pulse">
                                        Sedang Aktif
                                    </span>
                                <% } else if (st.status === 'PAUSED') { %>
                                    <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">
                                        Dijeda (<%= formatDurationDetailed(st.total_active_seconds) %>)
                                    </span>
                                <% } else { %>
                                    <span class="text-[10px] font-medium text-slate-400">
                                        Menunggu
                                    </span>
                                <% } %>
                            </div>
                        </div>

                    </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- Section Riwayat Log Waktu (Time Logs Audit Trail) -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-200">
                <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-2">
                    <i data-lucide="history" class="w-4 h-4 text-blue-600"></i>
                    <span>Log Aktivitas Tombol Timer (Mulai, Jeda, Selesai)</span>
                </h2>
                <p class="text-xs text-slate-500">Catatan audit transparan timestamp setiap PIC divisi menekan tombol kerja</p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">Waktu (Timestamp)</th>
                            <th class="py-3 px-4">Tahapan Divisi</th>
                            <th class="py-3 px-4">PIC / User</th>
                            <th class="py-3 px-4 text-center">Aksi Tombol</th>
                            <th class="py-3 px-4 text-right">Durasi Sesi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (timeLogs.length === 0) { %>
                        <tr>
                            <td colspan="5" class="py-6 text-center text-slate-400">Belum ada catatan aktivitas timer untuk pesanan ini.</td>
                        </tr>
                        <% } %>

                        <% timeLogs.forEach(log => { %>
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-2.5 px-4 font-mono text-[11px] text-slate-500">
                                <%= log.timestamp %>
                            </td>
                            <td class="py-2.5 px-4 font-semibold text-slate-800">
                                <%= log.stage_name %>
                            </td>
                            <td class="py-2.5 px-4">
                                <span class="font-medium text-slate-700 block"><%= log.user_name %></span>
                                <span class="text-[10px] text-slate-400 block"><%= ROLE_LABELS[log.user_role] || log.user_role %></span>
                            </td>
                            <td class="py-2.5 px-4 text-center">
                                <% if (log.action === 'START') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700">Mulai (Start)</span>
                                <% } else if (log.action === 'PAUSE') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700">Jeda (Pause)</span>
                                <% } else if (log.action === 'RESUME') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-700">Lanjutkan</span>
                                <% } else if (log.action === 'COMPLETE') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700">Selesai (Complete)</span>
                                <% } else { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700"><%= log.action %></span>
                                <% } %>
                            </td>
                            <td class="py-2.5 px-4 text-right font-mono font-semibold text-slate-800">
                                <%= log.duration_seconds > 0 ? formatDurationDetailed(log.duration_seconds) : '-' %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section Riwayat Notifikasi & Perubahan Owner -->
        <% if (notifications && notifications.length > 0) { %>
        <div class="mt-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-4 border-b border-slate-200 flex items-center space-x-2">
                <i data-lucide="bell" class="w-4 h-4 text-amber-500"></i>
                <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Riwayat Notifikasi & Perubahan oleh Owner</h2>
            </div>
            <div class="divide-y divide-slate-100">
                <% notifications.forEach(notif => { %>
                <div class="p-4 flex items-start justify-between gap-3 hover:bg-slate-50 transition">
                    <div class="flex items-start space-x-3">
                        <span class="w-2 h-2 rounded-full mt-1.5 shrink-0 <%= notif.type === 'ORDER_CANCELLED' ? 'bg-rose-500' : 'bg-amber-500' %>"></span>
                        <div>
                            <span class="text-xs font-bold text-slate-900 block"><%= notif.title %></span>
                            <p class="text-xs text-slate-600 mt-0.5 leading-relaxed"><%= notif.message %></p>
                            <span class="text-[10px] text-slate-400 mt-1 block">Oleh: <%= notif.author_name || 'Owner' %> &bull; <%= notif.created_at %></span>
                        </div>
                    </div>
                    <% if (notif.old_value && notif.new_value) { %>
                    <div class="text-right shrink-0">
                        <span class="text-[10px] text-slate-400 block line-through"><%= notif.old_value %></span>
                        <span class="text-xs font-black text-emerald-600 block"><%= notif.new_value %></span>
                    </div>
                    <% } %>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- MODAL KONFIRMASI PEMBATALAN PESANAN -->
        <div id="cancelModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop">
            <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
                <div class="flex items-center space-x-2.5 text-rose-600 mb-3">
                    <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                    <h3 class="text-base font-black text-slate-900">Batalkan Pesanan Ini?</h3>
                </div>
                <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                    Pesanan <strong class="text-slate-800"><%= order.order_number %></strong> akan dihentikan dari seluruh proses produksi. Notifikasi pembatalan darurat akan langsung dikirimkan ke lantai produksi.
                </p>

                <form action="/admin/orders/<%= order.id %>/cancel" method="POST" class="space-y-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Alasan Pembatalan *</label>
                        <textarea name="reason" required rows="2" placeholder="Contoh: Pemesan membatalkan order / perubahan total spesifikasi" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
                    </div>

                    <div class="pt-2 flex items-center justify-end space-x-2">
                        <button type="button" onclick="closeCancelModal()" class="px-4 py-2 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100">
                            Batal
                        </button>
                        <button type="submit" class="px-5 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition flex items-center space-x-1.5 shadow-md shadow-rose-500/20">
                            <i data-lucide="ban" class="w-3.5 h-3.5"></i>
                            <span>Ya, Batalkan Pesanan</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>
</div>

<%- include('../partials/mobile-nav') %>

<script>
    function openCancelModal() {
        document.getElementById('cancelModal').classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('cancelModal').classList.add('hidden');
    }

    if (window.lucide) {
        lucide.createIcons();
    }
</script>
</body>
</html>

