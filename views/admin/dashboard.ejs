<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">WIP Control Room & Monitoring</h1>
                <p class="text-sm text-slate-500">Pantau status antrean, beban kerja divisi, dan progres produksi real-time</p>
            </div>
            <div class="flex items-center space-x-2">
                <a href="/admin/orders/new" class="inline-flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-xl text-sm shadow-md shadow-blue-500/20 transition">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Buat SPK Baru</span>
                </a>
            </div>
        </div>

        <!-- KPI Summary Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4 mb-8">
            <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Pesanan</p>
                <div class="mt-2 flex items-baseline justify-between">
                    <p class="text-2xl font-black text-slate-800"><%= stats.total %></p>
                    <span class="text-xs font-semibold text-slate-400"><%= stats.kaos %> Kaos / <%= stats.jersey %> Jersey</span>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-blue-200/80 shadow-sm bg-gradient-to-br from-white to-blue-50/50">
                <p class="text-xs font-bold text-blue-600 uppercase tracking-wider">Sedang Dikerjakan</p>
                <div class="mt-2 flex items-baseline justify-between">
                    <p class="text-2xl font-black text-blue-700"><%= stats.inProgress %></p>
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-ping"></span>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-amber-200/80 shadow-sm">
                <p class="text-xs font-bold text-amber-600 uppercase tracking-wider">Menunggu / Dijeda</p>
                <div class="mt-2 flex items-baseline justify-between">
                    <p class="text-2xl font-black text-amber-700"><%= stats.waiting + stats.paused %></p>
                    <span class="text-xs text-amber-600 font-semibold"><%= stats.paused %> paused</span>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-emerald-200/80 shadow-sm bg-gradient-to-br from-white to-emerald-50/50">
                <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">Selesai Produksi</p>
                <div class="mt-2 flex items-baseline justify-between">
                    <p class="text-2xl font-black text-emerald-700"><%= stats.completed %></p>
                    <i data-lucide="check-check" class="w-5 h-5 text-emerald-500"></i>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-purple-200/80 shadow-sm col-span-2 lg:col-span-1">
                <p class="text-xs font-bold text-purple-600 uppercase tracking-wider">Total Pcs Dalam WIP</p>
                <div class="mt-2 flex items-baseline justify-between">
                    <p class="text-2xl font-black text-purple-700"><%= stats.activePcs %> <span class="text-xs font-normal text-slate-500">pcs</span></p>
                    <i data-lucide="package" class="w-5 h-5 text-purple-400"></i>
                </div>
            </div>
        </div>

        <!-- Grid 2 Kolom: Antrean Beban Divisi & Statistik QC -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            
            <!-- Antrean Per Meja Divisi (Workstation Load) -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-2">
                        <i data-lucide="activity" class="w-4 h-4 text-blue-600"></i>
                        <span>Beban Antrean Aktif Meja Divisi</span>
                    </h2>
                    <span class="text-xs text-purple-700 bg-purple-50 px-2.5 py-1 rounded-lg border border-purple-200/60 font-bold flex items-center space-x-1">
                        <i data-lucide="eye" class="w-3.5 h-3.5 text-purple-600"></i>
                        <span>Klik meja untuk pantau langsung tanpa login ulang &rarr;</span>
                    </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    
                    <!-- Desain -->
                    <a href="/division/queue?view_role=desain" class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:border-blue-300 hover:bg-blue-50/50 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-600">🎨 Desain</span>
                            <span class="text-lg font-black <%= roleOrderCount.desain > 0 ? 'text-blue-700' : 'text-slate-400' %>"><%= roleOrderCount.desain %></span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Mockup & Pola</p>
                    </a>

                    <!-- Cetak Sablon / Sublim -->
                    <a href="/division/queue?view_role=print_sablon" class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:border-amber-300 hover:bg-amber-50/50 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-600">🖨️ Sablon / Sublim</span>
                            <span class="text-lg font-black <%= roleOrderCount.print_sablon > 0 ? 'text-amber-700' : 'text-slate-400' %>"><%= roleOrderCount.print_sablon %></span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Film, Afdruk & Heatpress</p>
                    </a>

                    <!-- Potong -->
                    <a href="/division/queue?view_role=potong" class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:border-indigo-300 hover:bg-indigo-50/50 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-600">✂️ Potong</span>
                            <span class="text-lg font-black <%= roleOrderCount.potong > 0 ? 'text-indigo-700' : 'text-slate-400' %>"><%= roleOrderCount.potong %></span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Cutting Kain Pola</p>
                    </a>

                    <!-- Jahit -->
                    <a href="/division/queue?view_role=jahit" class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:border-emerald-300 hover:bg-emerald-50/50 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-600">🧵 Jahit</span>
                            <span class="text-lg font-black <%= roleOrderCount.jahit > 0 ? 'text-emerald-700' : 'text-slate-400' %>"><%= roleOrderCount.jahit %></span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Obras, Rantai, Assembly</p>
                    </a>

                    <!-- QC & Packing -->
                    <a href="/division/queue?view_role=qc_packing" class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:border-rose-300 hover:bg-rose-50/50 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-600">🔍 QC & Packing</span>
                            <span class="text-lg font-black <%= roleOrderCount.qc_packing > 0 ? 'text-rose-700' : 'text-slate-400' %>"><%= roleOrderCount.qc_packing %></span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Inspeksi & Plastik</p>
                    </a>

                    <!-- Kirim -->
                    <a href="/division/queue?view_role=kirim" class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:border-sky-300 hover:bg-sky-50/50 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-600">📦 Ekspedisi</span>
                            <span class="text-lg font-black <%= roleOrderCount.kirim > 0 ? 'text-sky-700' : 'text-slate-400' %>"><%= roleOrderCount.kirim %></span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Packing Koli & Resi</p>
                    </a>

                </div>
            </div>

            <!-- Rekapitulasi & Mutu QC -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-2 mb-4">
                        <i data-lucide="award" class="w-4 h-4 text-emerald-600"></i>
                        <span>Kualitas Produksi (QC)</span>
                    </h2>

                    <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-100 text-center mb-4">
                        <p class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Persentase Keberhasilan QC</p>
                        <p class="text-4xl font-black text-emerald-800 mt-1">
                            <%= qcStats && qcStats.avg_pass_rate ? Number(qcStats.avg_pass_rate).toFixed(1) : '100' %><span class="text-xl font-bold">%</span>
                        </p>
                        <p class="text-xs text-emerald-600 mt-0.5">Tingkat kelulusan lolos inspeksi</p>
                    </div>

                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Total Pcs Diperiksa:</span>
                            <span class="font-bold text-slate-800"><%= qcStats && qcStats.sum_checked ? qcStats.sum_checked : 0 %> pcs</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Pcs Lolos (Approved):</span>
                            <span class="font-bold text-emerald-700"><%= qcStats && qcStats.sum_passed ? qcStats.sum_passed : 0 %> pcs</span>
                        </div>
                        <div class="flex justify-between py-1">
                            <span class="text-slate-500">Pcs Cacat / Reject:</span>
                            <span class="font-bold text-rose-600"><%= qcStats && qcStats.sum_reject ? qcStats.sum_reject : 0 %> pcs</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400 flex items-center space-x-1">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-500"></i>
                    <span>Diinput pada tahap akhir QC & Packing</span>
                </div>
            </div>

        </div>

        <!-- Section Riwayat Notifikasi & Perubahan Terkini -->
        <% if (typeof recentNotifications !== 'undefined' && recentNotifications && recentNotifications.length > 0) { %>
        <div class="mb-8 bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center space-x-1.5">
                    <i data-lucide="bell" class="w-4 h-4 text-amber-500"></i>
                    <span>Aktivitas Notifikasi & Perubahan Terkini</span>
                </span>
                <span class="text-[10px] text-slate-400">Tersinkronisasi ke Meja Lantai Produksi</span>
            </div>
            <div class="space-y-2">
                <% recentNotifications.forEach(notif => { %>
                <div class="flex items-center justify-between text-xs py-1.5 px-2.5 rounded-xl bg-slate-50 border border-slate-100">
                    <div class="flex items-center space-x-2">
                        <span class="text-sm"><%= notif.type === 'ORDER_CANCELLED' ? '⛔' : '⚡' %></span>
                        <span class="font-bold text-slate-800"><%= notif.order_number %></span>
                        <span class="text-slate-600 truncate max-w-[280px] sm:max-w-md"><%= notif.title %>: <%= notif.message %></span>
                    </div>
                    <span class="text-[10px] text-slate-400 font-mono shrink-0"><%= notif.created_at %></span>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Tabel Pesanan Terkini -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-900">Daftar Pesanan & Status Tahapan Terkini</h2>
                    <p class="text-xs text-slate-500">Klik baris pesanan untuk melihat detail SPK, lembar fisik A4, atau rekapitulasi waktu</p>
                </div>
                <a href="/admin/orders" class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center space-x-1">
                    <span>Lihat Semua Pesanan &rarr;</span>
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">No. SPK & Tracking</th>
                            <th class="py-3 px-4">Nama Artikel & Pelanggan</th>
                            <th class="py-3 px-4 text-center">Kategori</th>
                            <th class="py-3 px-4 text-center">Qty (Pcs)</th>
                            <th class="py-3 px-4">Tahapan & Divisi Aktif</th>
                            <th class="py-3 px-4 text-center">Status</th>
                            <th class="py-3 px-4 text-center">Deadline</th>
                            <th class="py-3 px-4 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (recentOrders.length === 0) { %>
                        <tr>
                            <td colspan="8" class="py-8 text-center text-slate-400">Belum ada data pesanan. Klik "Buat SPK Baru" untuk memulai.</td>
                        </tr>
                        <% } %>

                        <% recentOrders.forEach(order => { %>
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-3.5 px-4">
                                <span class="font-bold text-slate-900 block"><%= order.order_number %></span>
                                <a href="/track/<%= order.tracking_code %>" target="_blank" class="text-[10px] font-mono text-blue-600 hover:underline">
                                    <%= order.tracking_code %> ↗
                                </a>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="font-semibold text-slate-800 block text-sm"><%= order.article_name %></span>
                                <span class="text-xs text-slate-500"><%= order.customer_name %></span>
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold uppercase <%= order.category === 'jersey' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                                    <%= order.category %>
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-center font-bold text-slate-800">
                                <%= order.total_pcs %>
                            </td>
                            <td class="py-3.5 px-4">
                                <% if (order.status === 'COMPLETED') { %>
                                    <span class="inline-flex items-center space-x-1 text-emerald-700 font-bold">
                                        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
                                        <span>Produksi Selesai</span>
                                    </span>
                                <% } else if (order.active_stage_name) { %>
                                    <div class="space-y-0.5">
                                        <div class="font-bold text-slate-900 flex items-center space-x-1.5">
                                            <% if (order.status === 'IN_PROGRESS') { %>
                                                <span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span>
                                            <% } else if (order.status === 'PAUSED') { %>
                                                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                            <% } else { %>
                                                <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                            <% } %>
                                            <span><%= order.active_stage_name %></span>
                                        </div>
                                        <span class="text-[10px] font-medium text-slate-500 block">
                                            <%= ROLE_LABELS[order.active_stage_role] || order.active_stage_role %>
                                        </span>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-400">-</span>
                                <% } %>
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <% if (order.status === 'IN_PROGRESS') { %>
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200">
                                        Dikerjakan
                                    </span>
                                <% } else if (order.status === 'PAUSED') { %>
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                        Dijeda
                                    </span>
                                <% } else if (order.status === 'COMPLETED') { %>
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                        Selesai
                                    </span>
                                <% } else { %>
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                        Antrean
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-3.5 px-4 text-center font-medium text-slate-600">
                                <%= order.deadline_date || '-' %>
                            </td>
                            <td class="py-3.5 px-4 text-right space-x-1 whitespace-nowrap">
                                <a href="/admin/orders/<%= order.id %>" class="inline-flex items-center px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-xs font-semibold transition" title="Lihat Detail & Rekap Waktu">
                                    <i data-lucide="eye" class="w-3.5 h-3.5 mr-1"></i> Detail
                                </a>
                                <a href="/admin/orders/<%= order.id %>/edit" class="inline-flex items-center px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-800 rounded text-xs font-semibold transition" title="Edit / Tambah Qty">
                                    <i data-lucide="edit" class="w-3.5 h-3.5 mr-1"></i> Edit
                                </a>
                                <a href="/admin/orders/<%= order.id %>/spk" target="_blank" class="inline-flex items-center px-2 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded text-xs font-semibold transition" title="Cetak SPK Fisik (A4)">
                                    <i data-lucide="printer" class="w-3.5 h-3.5 mr-1"></i> Cetak A4
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>

<%- include('../partials/mobile-nav') %>

<script src="/js/live-timer.js"></script>
<script src="/js/queue-actions.js"></script>
<script>
    if (window.lucide) {
        lucide.createIcons();
    }
</script>
</body>
</html>

