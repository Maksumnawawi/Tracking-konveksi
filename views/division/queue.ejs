    <div class="bg-white rounded-3xl max-w-md w-full p-5 sm:p-6 shadow-2xl text-slate-900 border border-slate-200 relative overflow-hidden" onclick="event.stopPropagation()">
        
        <!-- Header Modal -->
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
            <div class="flex items-center space-x-2.5">
