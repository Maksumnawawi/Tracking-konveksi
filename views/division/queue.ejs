<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="/js/live-timer.js"></script>
<script src="/js/queue-actions.js"></script>
<script>
    // Data antrean divisi untuk pencocokan instan di sisi klien
    const QUEUE_DATA = {
        waiting: <%- JSON.stringify((waitingList || []).map(item => ({
            id: item.id,
            order_id: item.order_id,
            order_number: item.order_number,
            tracking_code: item.tracking_code,
            po_number: item.po_number,
            article_name: item.article_name,
            customer_name: item.customer_name,
            total_pcs: item.total_pcs,
            stage_name: item.stage_name,
            category: item.category,
            fabric_type: item.fabric_type,
            print_type: item.print_type,
            warna_kaos: item.warna_kaos,
            notes: item.notes,
            deadline_date: item.deadline_date
        }))) %>,
        inProgress: <%- JSON.stringify((inProgressList || []).map(item => ({
            id: item.id,
            order_id: item.order_id,
            order_number: item.order_number,
            tracking_code: item.tracking_code,
            po_number: item.po_number,
            article_name: item.article_name,
            customer_name: item.customer_name,
            total_pcs: item.total_pcs,
            stage_name: item.stage_name,
            category: item.category,
            fabric_type: item.fabric_type,
            print_type: item.print_type,
            warna_kaos: item.warna_kaos,
            notes: item.notes,
            deadline_date: item.deadline_date
        }))) %>,
        paused: <%- JSON.stringify((pausedList || []).map(item => ({
            id: item.id,
            order_id: item.order_id,
            order_number: item.order_number,
            tracking_code: item.tracking_code,
            po_number: item.po_number,
            article_name: item.article_name,
            customer_name: item.customer_name,
            total_pcs: item.total_pcs,
            stage_name: item.stage_name,
            category: item.category,
            fabric_type: item.fabric_type,
            print_type: item.print_type,
            warna_kaos: item.warna_kaos,
            notes: item.notes,
            deadline_date: item.deadline_date
        }))) %>
    };

    let html5QrScanner = null;
    let currentFacingMode = "environment"; // default kamera belakang HP

    function playBeep(type = 'success') {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            if (type === 'success') {
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                osc.start();
                osc.stop(ctx.currentTime + 0.15);
            } else {
                osc.frequency.setValueAtTime(320, ctx.currentTime);
                gain.gain.setValueAtTime(0.25, ctx.currentTime);
                osc.start();
                osc.stop(ctx.currentTime + 0.22);
            }
        } catch(e) {}
    }

    function showScanResult(isSuccess, message) {
        const box = document.getElementById('scanStatusBox');
        if (!box) return;
        box.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 'bg-rose-50', 'text-rose-800', 'border-rose-200');
        if (isSuccess) {
            box.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
        } else {
            box.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
        }
        box.innerHTML = message;
    }

    function renderPreviewCard(matched, statusType) {
        stopCameraScanner();

        // Sembunyikan kamera, tampilkan kartu preview
        document.getElementById('scannerCameraView').classList.add('hidden');
        const resultCard = document.getElementById('scannerResultCard');
        resultCard.classList.remove('hidden');

        // Update teks header modal
        document.getElementById('scannerModalTitle').textContent = `Detail POK #${matched.po_number || 1}`;
        document.getElementById('scannerModalSubtitle').textContent = 'Periksa rincian sebelum memutuskan mulai bekerja';

        // Isi konten
        document.getElementById('previewPoBadge').textContent = `PO #${matched.po_number || 1}`;
        document.getElementById('previewCategoryBadge').textContent = (matched.category || 'KAOS').toUpperCase();
        document.getElementById('previewOrderNumber').textContent = matched.order_number || '';
        document.getElementById('previewArticleName').textContent = matched.article_name || '';
        document.getElementById('previewCustomerName').textContent = matched.customer_name || '';
        document.getElementById('previewTotalPcs').textContent = `${matched.total_pcs || 0} Pcs`;
        document.getElementById('previewFabric').textContent = matched.fabric_type || '-';
        document.getElementById('previewPrint').textContent = matched.print_type || '-';
        document.getElementById('previewWarnaKaos').textContent = matched.warna_kaos || '-';
        document.getElementById('previewStageName').textContent = matched.stage_name || '-';

        const statusContainer = document.getElementById('previewStatusContainer');
        const actionsContainer = document.getElementById('previewActionButtons');

        if (statusType === 'waiting') {
            statusContainer.innerHTML = `
                <div class="p-2.5 bg-blue-50 border border-blue-200 rounded-xl flex items-center justify-between">
                    <span class="font-bold text-blue-900 text-xs flex items-center space-x-1.5">
                        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                        <span>Status: Antrean Masuk (Belum Dimulai)</span>
                    </span>
                    <span class="text-[10px] text-blue-700 font-semibold">Siap Dikerjakan</span>
                </div>
            `;

            actionsContainer.innerHTML = `
                <form action="/division/stage/${matched.id}/action" method="POST" class="m-0">
                    <input type="hidden" name="action" value="start">
                    <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-lg shadow-blue-500/20 transition cursor-pointer">
                        <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                        <span>Mulai Kerjakan Sekarang (Start Timer)</span>
                    </button>
                </form>
                <div class="grid grid-cols-2 gap-2 pt-1">
                    <button type="button" onclick="closeQrScannerModal()" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition cursor-pointer text-center">
                        ✕ Tutup (Cuma Lihat)
                    </button>
                    <button type="button" onclick="resetToScannerView()" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-red-600 font-bold rounded-xl text-xs transition cursor-pointer flex items-center justify-center space-x-1">
                        <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                        <span>Scan POK Lain</span>
                    </button>
                </div>
            `;
        } else if (statusType === 'inProgress') {
            statusContainer.innerHTML = `
                <div class="p-2.5 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center justify-between">
                    <span class="font-bold text-emerald-900 text-xs flex items-center space-x-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-ping"></span>
                        <span>Status: Sedang Aktif Dikerjakan</span>
                    </span>
                    <span class="text-[10px] text-emerald-700 font-semibold font-mono">Timer Berjalan</span>
                </div>
            `;

            actionsContainer.innerHTML = `
                <button type="button" onclick="closeQrScannerModal()" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs transition cursor-pointer">
                    Tutup (Pesanan Sudah Berjalan)
                </button>
                <button type="button" onclick="resetToScannerView()" class="w-full py-2 text-slate-500 hover:text-red-600 font-bold text-xs flex items-center justify-center space-x-1 cursor-pointer">
                    <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                    <span>Scan POK Lain</span>
                </button>
            `;
        } else if (statusType === 'paused') {
            statusContainer.innerHTML = `
                <div class="p-2.5 bg-amber-50 border border-amber-200 rounded-xl flex items-center justify-between">
                    <span class="font-bold text-amber-900 text-xs flex items-center space-x-1.5">
                        <span class="w-2 h-2 rounded-full bg-amber-600"></span>
                        <span>Status: Sedang Dijeda (Pause)</span>
                    </span>
                    <span class="text-[10px] text-amber-700 font-semibold">Menunggu Lanjut</span>
                </div>
            `;

            actionsContainer.innerHTML = `
                <form action="/division/stage/${matched.id}/action" method="POST" class="m-0">
                    <input type="hidden" name="action" value="resume">
                    <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-xl text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-lg shadow-blue-500/20 transition cursor-pointer">
                        <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                        <span>Lanjutkan Pengerjaan (Resume Timer)</span>
                    </button>
                </form>
                <div class="grid grid-cols-2 gap-2 pt-1">
                    <button type="button" onclick="closeQrScannerModal()" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition cursor-pointer text-center">
                        ✕ Tutup
                    </button>
                    <button type="button" onclick="resetToScannerView()" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-red-600 font-bold rounded-xl text-xs transition cursor-pointer flex items-center justify-center space-x-1">
                        <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                        <span>Scan POK Lain</span>
                    </button>
                </div>
            `;
        }

        if (window.lucide) {
            lucide.createIcons();
        }
    }

    function processScannedCode(rawText) {
        if (!rawText) return;
        let code = String(rawText).trim();
        
        // Ekstrak jika formatnya URL tracking
        if (code.includes('/track/')) {
            const parts = code.split('/track/');
            code = parts[1].split('?')[0].split('#')[0];
        }

        const cleanCode = code.toUpperCase().replace(/\s+/g, '');
        const numOnly = code.replace(/[^0-9]/g, '');

        // 1. Cek apakah ada di antrean masuk (waitingList)
        const matchedWaiting = QUEUE_DATA.waiting.find(item => {
            if (item.tracking_code && item.tracking_code.toUpperCase() === cleanCode) return true;
            if (item.order_number && item.order_number.toUpperCase() === cleanCode) return true;
            if (numOnly && item.po_number && parseInt(item.po_number) === parseInt(numOnly)) return true;
            return false;
        });

        if (matchedWaiting) {
            playBeep('success');
            // Tampilkan kartu preview, JANGAN langsung submit otomatis
            renderPreviewCard(matchedWaiting, 'waiting');
            return;
        }

        // 2. Cek apakah sedang dikerjakan
        const matchedProgress = QUEUE_DATA.inProgress.find(item => {
            if (item.tracking_code && item.tracking_code.toUpperCase() === cleanCode) return true;
            if (item.order_number && item.order_number.toUpperCase() === cleanCode) return true;
            if (numOnly && item.po_number && parseInt(item.po_number) === parseInt(numOnly)) return true;
            return false;
        });

        if (matchedProgress) {
            playBeep('success');
            renderPreviewCard(matchedProgress, 'inProgress');
            return;
        }

        // 3. Cek apakah sedang dijeda (paused)
        const matchedPaused = QUEUE_DATA.paused.find(item => {
            if (item.tracking_code && item.tracking_code.toUpperCase() === cleanCode) return true;
            if (item.order_number && item.order_number.toUpperCase() === cleanCode) return true;
            if (numOnly && item.po_number && parseInt(item.po_number) === parseInt(numOnly)) return true;
            return false;
        });

        if (matchedPaused) {
            playBeep('success');
            renderPreviewCard(matchedPaused, 'paused');
            return;
        }

        // 4. Tidak ditemukan pada antrean meja ini
        playBeep('error');
        showScanResult(false, `❌ Kode "${code}" tidak ditemukan pada antrean meja Anda saat ini.`);
    }

    function handleManualBarcodeInput(e) {
        e.preventDefault();
        const input = document.getElementById('manualBarcodeInput');
        if (!input || !input.value.trim()) return;
        const code = input.value.trim();
        input.value = '';
        openQrScannerModal();
        processScannedCode(code);
    }

    function resetToScannerView() {
        document.getElementById('scannerResultCard').classList.add('hidden');
        document.getElementById('scannerCameraView').classList.remove('hidden');
        document.getElementById('scannerModalTitle').textContent = 'Scan QR Lembar POK';
        document.getElementById('scannerModalSubtitle').textContent = 'Arahkan kamera ke QR Code di kertas POK';
        document.getElementById('scanStatusBox').classList.add('hidden');
        startCameraScanner();
    }

    function openQrScannerModal() {
        const modal = document.getElementById('qrScannerModal');
        if (!modal) return;
        modal.classList.remove('hidden');
        resetToScannerView();
    }

    function closeQrScannerModal() {
        const modal = document.getElementById('qrScannerModal');
        if (!modal) return;
        modal.classList.add('hidden');
        stopCameraScanner();
    }

    function startCameraScanner() {
        if (!window.Html5Qrcode) {
            alert('Library scanner belum selesai dimuat, silakan periksa koneksi internet.');
            return;
        }
        
        stopCameraScanner();

        html5QrScanner = new Html5Qrcode("qr-reader");
        const config = { 
            fps: 12, 
            qrbox: { width: 220, height: 220 },
            aspectRatio: 1.0
        };

        html5QrScanner.start(
            { facingMode: currentFacingMode },
            config,
            (decodedText) => {
                processScannedCode(decodedText);
            },
            (error) => {
                // scanning frame error (ignore continuous polling)
            }
        ).catch(err => {
            console.warn('Gagal akses kamera:', err);
            showScanResult(false, 'Kamera tidak dapat diakses (' + err + '). Pastikan Anda memberi izin kamera atau gunakan kolom input manual di atas.');
        });
    }

    function stopCameraScanner() {
        if (html5QrScanner) {
            html5QrScanner.stop().then(() => {
                html5QrScanner.clear();
                html5QrScanner = null;
            }).catch(e => {
                html5QrScanner = null;
            });
        }
    }

    function switchCamera() {
        currentFacingMode = currentFacingMode === "environment" ? "user" : "environment";
        startCameraScanner();
    }

    if (window.lucide) {
        lucide.createIcons();
    }
</script>
</body>
</html>

