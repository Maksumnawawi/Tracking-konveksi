<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0">
        
        <!-- KHUSUS OWNER: Banner Mode Supervisi Pantau Meja -->
        <% if (currentUser.role === 'admin') { %>
        <div class="mb-5 bg-gradient-to-r from-purple-50 to-indigo-50 border border-purple-200/80 text-purple-900 p-3.5 rounded-2xl text-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 shadow-sm">
            <div class="flex items-center space-x-2.5">
                <span class="w-7 h-7 rounded-lg bg-purple-200/70 text-purple-800 flex items-center justify-center text-sm font-bold shrink-0">👑</span>
                <div>
                    <span class="font-bold text-purple-950 block">Mode Supervisi Admin:</span>
                    <span class="text-purple-800 text-[11px]">Anda sedang memeriksa antrean <strong><%= ROLE_LABELS[activeRole] || activeRole %></strong> secara langsung tanpa perlu login ulang.</span>
                </div>
            </div>
            <a href="/admin/dashboard" class="inline-flex items-center space-x-1.5 px-3 py-1.5 bg-white border border-purple-200 rounded-xl text-xs font-bold text-purple-700 hover:bg-purple-100/50 shadow-sm transition shrink-0">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Kembali ke Dashboard Admin</span>
            </a>
        </div>
        <% } %>

        <!-- Header Meja Kerja Divisi -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
                <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= ROLE_BADGES[activeRole] || 'bg-slate-100' %>">
                        <%= ROLE_LABELS[activeRole] || activeRole %>
                    </span>
                    <span class="text-xs text-slate-400">Meja Kerja Operasional</span>
                </div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Daftar Antrean & Pengerjaan SPK</h1>
                <p class="text-xs text-slate-500">Tekan <strong>Mulai</strong> saat pengerjaan dimulai, <strong>Jeda</strong> saat istirahat/menunggu, dan <strong>Selesai</strong> untuk meneruskan ke divisi berikutnya.</p>
            </div>

            <!-- Jika Admin, bisa melihat antrean divisi mana saja -->
            <% if (currentUser.role === 'admin') { %>
            <div class="flex items-center space-x-2 bg-white p-2 rounded-xl border border-slate-200 shadow-sm text-xs">
                <span class="text-slate-500 font-semibold">Tampilan Meja:</span>
                <form action="/division/queue" method="GET" class="m-0">
                    <select name="view_role" onchange="this.form.submit()" class="bg-slate-50 border border-slate-300 rounded-lg font-bold text-slate-800 py-1 px-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        <option value="desain" <%= activeRole === 'desain' ? 'selected' : '' %>>🎨 Desain</option>
                        <option value="print_sablon" <%= activeRole === 'print_sablon' ? 'selected' : '' %>>🖨️ Cetak Sablon / Sublim</option>
                        <option value="potong" <%= activeRole === 'potong' ? 'selected' : '' %>>✂️ Potong</option>
                        <option value="jahit" <%= activeRole === 'jahit' ? 'selected' : '' %>>🧵 Jahit</option>
                        <option value="qc_packing" <%= activeRole === 'qc_packing' ? 'selected' : '' %>>🔍 QC & Packing</option>
                        <option value="kirim" <%= activeRole === 'kirim' ? 'selected' : '' %>>📦 Ekspedisi & Kirim</option>
                    </select>
                </form>
            </div>
            <% } %>
        </div>

        <!-- Feedback Alert Messages -->
        <% if (successMsg) { %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-sm flex items-center space-x-2">
            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600 shrink-0"></i>
            <span><%= successMsg %></span>
        </div>
        <% } %>
        <% if (errorMsg) { %>
        <div class="mb-6 bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl text-sm flex items-center space-x-2">
            <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 shrink-0"></i>
            <span><%= errorMsg %></span>
        </div>
        <% } %>

        <!-- PEMBERITAHUAN DARI OWNER UNTUK MEJA DIVISI (Penambahan Order / Pembatalan) -->
        <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
        <div class="space-y-3 mb-6">
            <% notifications.forEach(notif => { %>
            <div class="p-4 rounded-2xl border shadow-sm flex items-start justify-between gap-3 transition
                <%= notif.type === 'ORDER_CANCELLED' ? 'bg-rose-50 border-rose-300 text-rose-900' : 'bg-amber-50 border-amber-300 text-amber-900' %>">
                <div class="flex items-start space-x-3">
                    <span class="text-xl shrink-0 mt-0.5">
                        <%= notif.type === 'ORDER_CANCELLED' ? '⛔' : '⚡' %>
                    </span>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="font-black text-xs uppercase tracking-wider block"><%= notif.title %></span>
                            <% if (notif.is_read === 0) { %>
                            <span class="bg-red-500 text-white text-[9px] font-black px-1.5 py-0.2 rounded-full uppercase animate-pulse">Baru</span>
                            <% } %>
                        </div>
                        <p class="text-xs mt-1 leading-relaxed"><%= notif.message %></p>
                        <span class="text-[10px] text-slate-500 mt-1 block">Waktu: <%= notif.created_at %></span>
                    </div>
                </div>

                <% if (notif.is_read === 0) { %>
                <form action="/division/notifications/<%= notif.id %>/read" method="POST" class="shrink-0 m-0">
                    <button type="submit" class="px-2.5 py-1 rounded-lg bg-white border border-slate-300 text-[11px] font-bold text-slate-700 hover:bg-slate-100 transition shadow-sm">
                        ✓ Mengerti
                    </button>
                </form>
                <% } %>
            </div>
            <% }) %>
        </div>
        <% } %>

        <!-- Status Summary Stats Pills -->
        <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="bg-white p-3.5 rounded-xl border border-blue-200 shadow-sm flex items-center space-x-3">
                <div class="w-9 h-9 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold">
                    <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                </div>
                <div>
                    <span class="text-xs text-slate-500 font-semibold block">Sedang Dikerjakan</span>
                    <span class="text-lg font-black text-blue-700"><%= inProgressList.length %></span>
                </div>
            </div>

            <div class="bg-white p-3.5 rounded-xl border border-amber-200 shadow-sm flex items-center space-x-3">
                <div class="w-9 h-9 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                    <i data-lucide="pause" class="w-4 h-4 fill-current"></i>
                </div>
                <div>
                    <span class="text-xs text-slate-500 font-semibold block">Sedang Dijeda</span>
                    <span class="text-lg font-black text-amber-700"><%= pausedList.length %></span>
                </div>
            </div>

            <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-3">
                <div class="w-9 h-9 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center font-bold">
                    <i data-lucide="inbox" class="w-4 h-4"></i>
                </div>
                <div>
                    <span class="text-xs text-slate-500 font-semibold block">Antrean Masuk</span>
                    <span class="text-lg font-black text-slate-800"><%= waitingList.length %></span>
                </div>
            </div>
        </div>

        <!-- BANNER SCANNER BARCODE / QR LEMBAR POK MEJA DIVISI -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-red-950 text-white p-4 sm:p-5 rounded-2xl shadow-lg border border-red-500/30 mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3.5 w-full md:w-auto">
                <div class="w-12 h-12 rounded-2xl bg-red-600/30 border border-red-500/50 flex items-center justify-center text-red-400 shrink-0 shadow-inner">
                    <i data-lucide="qr-code" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h3 class="text-sm font-black uppercase tracking-wider text-white">Scan Barcode / QR Lembar POK</h3>
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-slate-700 text-slate-300 border border-slate-600">Preview &amp; Mulai</span>
                    </div>
                    <p class="text-xs text-slate-300 mt-0.5">Scan lembar POK yang tiba di meja Anda untuk melihat spesifikasi atau mulai pengerjaan.</p>
                </div>
            </div>

            <!-- Tombol Buka Kamera Scanner & Input Scanner Tembak USB -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full md:w-auto shrink-0">
                <!-- Input Tembak Barcode / Manual -->
                <form onsubmit="handleManualBarcodeInput(event)" class="relative m-0 flex-1 sm:w-52">
                    <input type="text" id="manualBarcodeInput" placeholder="Tembak / ketik No. PO..." class="w-full pl-8 pr-3 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-400 focus:ring-2 focus:ring-red-500 focus:outline-none font-mono">
                    <i data-lucide="barcode" class="w-4 h-4 text-slate-400 absolute left-2.5 top-3"></i>
                </form>
                <!-- Tombol Kamera -->
                <button type="button" onclick="openQrScannerModal()" class="px-4 py-2.5 bg-red-600 hover:bg-red-500 text-white rounded-xl text-xs font-black transition flex items-center justify-center space-x-2 shadow-md shadow-red-500/30 shrink-0 cursor-pointer">
                    <i data-lucide="camera" class="w-4 h-4"></i>
                    <span>Buka Kamera Scan</span>
                </button>
            </div>
        </div>

        <!-- Section 1: SEDANG DIKERJAKAN (ACTIVE LIVE TIMER) -->
        <div class="mb-8">
            <div class="flex items-center space-x-2 mb-3">
                <span class="w-3 h-3 rounded-full bg-blue-600 animate-ping"></span>
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800">Sedang Dikerjakan di Meja Anda (<%= inProgressList.length %>)</h2>
            </div>

            <% if (inProgressList.length === 0) { %>
            <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center text-slate-400">
                <i data-lucide="coffee" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                <p class="text-xs font-semibold">Tidak ada pesanan yang sedang aktif berjalan di meja Anda.</p>
                <p class="text-[11px] text-slate-400 mt-1">Pilih salah satu pesanan dari daftar antrean masuk di bawah untuk mulai bekerja.</p>
            </div>
            <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% inProgressList.forEach(item => { %>
                <div class="bg-white rounded-2xl border-2 border-blue-500 shadow-lg shadow-blue-500/10 p-5 flex flex-col justify-between"
                     data-live-timer
                     data-timer-status="IN_PROGRESS"
                     data-timer-seconds="<%= item.total_active_seconds || 0 %>"
                     data-started-at="<%= item.last_timer_started_at %>">
                    
                    <div>
                        <!-- Top Order Tag -->
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded <%= item.category === 'jersey' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                                    <%= item.category %>
                                </span>
                                <span class="font-mono text-xs font-bold text-slate-700 ml-1.5"><%= item.order_number %></span>
                            </div>
                            <span class="px-2 py-0.5 bg-blue-100 text-blue-800 rounded-full text-[10px] font-bold timer-active-badge flex items-center space-x-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                                <span>TIMER BERJALAN</span>
                            </span>
                        </div>

                        <!-- Article & Customer -->
                        <h3 class="text-base font-black text-slate-900 leading-snug"><%= item.article_name %></h3>
                        <p class="text-xs text-slate-500 mb-3"><%= item.customer_name %> &bull; <strong class="text-slate-700"><%= item.total_pcs %> Pcs</strong></p>

                        <!-- Live Digital Clock Display -->
                        <div class="p-4 bg-slate-950 text-white rounded-xl flex items-center justify-between mb-4 shadow-inner">
                            <div>
                                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Waktu Kerja Bersih:</span>
                                <span class="text-2xl font-black font-mono text-emerald-400 tracking-wider timer-clock">00:00:00</span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] text-slate-400 block">Tahapan:</span>
                                <span class="text-xs font-bold text-white"><%= item.stage_name %></span>
                            </div>
                        </div>

                        <!-- Technical Specs -->
                        <div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 p-2.5 rounded-xl border border-slate-200 mb-4">
                            <div>
                                <span class="text-[10px] text-slate-400 block">Bahan Kain:</span>
                                <span class="font-semibold text-slate-800 truncate block"><%= item.fabric_type || '-' %></span>
                            </div>
                            <div>
                                <span class="text-[10px] text-slate-400 block">Sablon/Sublim:</span>
                                <span class="font-semibold text-slate-800 truncate block"><%= item.print_type || '-' %></span>
                            </div>
                        </div>

                        <% if (item.notes) { %>
                        <p class="text-xs text-slate-600 bg-amber-50/70 p-2 rounded-lg border border-amber-200/60 mb-4 italic">
                            "<%= item.notes %>"
                        </p>
                        <% } %>
                    </div>

                    <!-- Tombol Aksi: JEDA (Pause) & SELESAI (Complete) -->
                    <div class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-100">
                        
                        <!-- Form Jeda -->
                        <form action="/division/stage/<%= item.id %>/action" method="POST" onsubmit="return confirmAction('Jeda Sementara', '<%= item.stage_name %>')">
                            <input type="hidden" name="action" value="pause">
                            <button type="submit" class="w-full py-2.5 px-3 bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold rounded-xl text-xs flex items-center justify-center space-x-1.5 transition">
                                <i data-lucide="pause" class="w-4 h-4 fill-current"></i>
                                <span>Jeda (Pause)</span>
                            </button>
                        </form>

                        <!-- Tombol Selesai (Khusus QC & Packing membuka modal, selain itu submit langsung) -->
                        <% if (item.stage_name.toLowerCase().includes('qc')) { %>
                        <button type="button" onclick="openQcModal(<%= item.id %>, <%= item.order_id %>, '<%= item.order_number %>', <%= item.total_pcs %>)" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-md shadow-emerald-500/20 transition">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            <span>Input QC & Selesai</span>
                        </button>
                        <% } else { %>
                        <form action="/division/stage/<%= item.id %>/action" method="POST" onsubmit="return confirmAction('Selesai', '<%= item.stage_name %>')">
                            <input type="hidden" name="action" value="complete">
                            <button type="submit" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-md shadow-emerald-500/20 transition">
                                <i data-lucide="check-check" class="w-4 h-4"></i>
                                <span>Selesai & Lanjut &rarr;</span>
                            </button>
                        </form>
                        <% } %>

                    </div>
                    <!-- Khusus Divisi Sablon: Tombol Cepat Langsung ke Packing (Kaos Jadi / Tanpa Jahit) -->
                    <% if (item.assigned_role === 'print_sablon') { %>
                    <div class="mt-2 pt-2 border-t border-slate-100">
                        <form action="/division/stage/<%= item.id %>/action" method="POST" onsubmit="return confirmAction('Selesai Sablon & Langsung ke QC Packing (Lewati Potong & Jahit)?', '<%= item.order_number %>')">
                            <input type="hidden" name="action" value="complete">
                            <input type="hidden" name="jump_to_role" value="qc_packing">
                            <button type="submit" class="w-full py-1.5 px-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 font-bold rounded-xl text-[11px] flex items-center justify-center space-x-1.5 transition cursor-pointer" title="Gunakan jika order adalah kaos jadi yang tidak perlu dipotong atau dijahit">
                                <i data-lucide="fast-forward" class="w-3.5 h-3.5 text-indigo-600"></i>
                                <span>Kaos Jadi: Selesai Langsung ke Packing ⚡</span>
                            </button>
                        </form>
                    </div>
                    <% } %>


                </div>
                <% }) %>
            </div>
            <% } %>
        </div>

        <!-- Section 2: DIJEDA (PAUSED) -->
        <% if (pausedList.length > 0) { %>
        <div class="mb-8">
            <div class="flex items-center space-x-2 mb-3">
                <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800">Sedang Dijeda / Istirahat (<%= pausedList.length %>)</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% pausedList.forEach(item => { %>
                <div class="bg-white rounded-2xl border border-amber-300 shadow-sm p-4 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="font-mono text-xs font-bold text-slate-800"><%= item.order_number %></span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">DIJEDA</span>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm"><%= item.article_name %></h4>
                        <p class="text-xs text-slate-500 mb-3"><%= item.customer_name %> &bull; <%= item.total_pcs %> pcs</p>

                        <div class="p-2.5 bg-amber-50/60 rounded-xl border border-amber-200/80 mb-3 flex items-center justify-between text-xs">
                            <span class="text-amber-800 font-semibold">Durasi Tersimpan:</span>
                            <span class="font-mono font-bold text-amber-900"><%= formatDurationClock(item.total_active_seconds) %></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100">
                        <form action="/division/stage/<%= item.id %>/action" method="POST">
                            <input type="hidden" name="action" value="resume">
                            <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-xs flex items-center justify-center space-x-1 transition">
                                <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
                                <span>Lanjutkan</span>
                            </button>
                        </form>

                        <% if (item.stage_name.toLowerCase().includes('qc')) { %>
                        <button type="button" onclick="openQcModal(<%= item.id %>, <%= item.order_id %>, '<%= item.order_number %>', <%= item.total_pcs %>)" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs transition">
                            Input QC
                        </button>
                        <% } else { %>
                        <form action="/division/stage/<%= item.id %>/action" method="POST" onsubmit="return confirmAction('Selesai', '<%= item.stage_name %>')">
                            <input type="hidden" name="action" value="complete">
                            <button type="submit" class="w-full py-2 bg-emerald-100 hover:bg-emerald-200 text-emerald-800 font-bold rounded-lg text-xs transition">
                                Selesai
                            </button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Section 3: ANTREAN MASUK (WAITING TO START) -->
        <div class="mb-8">
            <div class="flex items-center space-x-2 mb-3">
                <span class="w-3 h-3 rounded-full bg-slate-400"></span>
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800">Antrean Masuk ke Meja Anda (<%= waitingList.length %>)</h2>
            </div>

            <% if (waitingList.length === 0) { %>
            <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-400">
                <i data-lucide="check-circle" class="w-8 h-8 mx-auto mb-2 text-emerald-400"></i>
                <p class="text-xs font-semibold">Semua antrean pesanan untuk meja Anda telah dikerjakan!</p>
            </div>
            <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% waitingList.forEach(item => { %>
                <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 hover:border-blue-300 transition flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-mono text-xs font-bold text-slate-700"><%= item.order_number %></span>
                            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded <%= item.category === 'jersey' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                                <%= item.category %>
                            </span>
                        </div>

                        <h3 class="font-bold text-slate-900 text-sm leading-snug"><%= item.article_name %></h3>
                        <p class="text-xs text-slate-500 mb-3"><%= item.customer_name %> &bull; <strong class="text-slate-800"><%= item.total_pcs %> Pcs</strong></p>

                        <div class="space-y-1 text-xs bg-slate-50 p-2.5 rounded-xl border border-slate-200/70 mb-3">
                            <div class="flex justify-between">
                                <span class="text-slate-400">Tahap:</span>
                                <span class="font-bold text-slate-800"><%= item.stage_name %></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Deadline:</span>
                                <span class="font-bold text-rose-600"><%= item.deadline_date || '-' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Tombol Mulai -->
                    <form action="/division/stage/<%= item.id %>/action" method="POST" onsubmit="return confirmAction('Mulai Pengerjaan', '<%= item.stage_name %>')">
                        <input type="hidden" name="action" value="start">
                        <button type="submit" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-2 shadow-md shadow-blue-500/20 transition">
                            <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                            <span>Mulai Kerjakan (Start Timer)</span>
                        </button>
                    </form>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>

        <!-- Section 4: RIWAYAT PESANAN SELESAI OLEH DIVISI INI -->
        <% if (history && history.length > 0) { %>
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-4 border-b border-slate-200">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Riwayat Pesanan yang Baru Selesai Dikerjakan Meja Anda</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-2.5 px-4">No SPK</th>
                            <th class="py-2.5 px-4">Nama Artikel</th>
                            <th class="py-2.5 px-4">Tahapan</th>
                            <th class="py-2.5 px-4 text-center">Durasi Bersih</th>
                            <th class="py-2.5 px-4 text-right">Waktu Selesai</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% history.forEach(h => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="py-2 px-4 font-mono font-bold text-slate-800"><%= h.order_number %></td>
                            <td class="py-2 px-4 font-medium text-slate-800"><%= h.article_name %></td>
                            <td class="py-2 px-4 font-semibold text-slate-700"><%= h.stage_name %></td>
                            <td class="py-2 px-4 text-center font-mono font-bold text-emerald-700"><%= formatDurationClock(h.total_active_seconds) %></td>
                            <td class="py-2 px-4 text-right text-[11px] text-slate-400"><%= h.completed_at %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>

    </main>
</div>

