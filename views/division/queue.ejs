                <!-- Info Artikel & Customer -->
                <div>
                    <h4 id="previewArticleName" class="text-base font-black text-slate-900 leading-snug">Nama Artikel</h4>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Pemesan: <strong id="previewCustomerName" class="text-slate-800">Nama Customer</strong> &bull; 
                        Total: <strong id="previewTotalPcs" class="text-red-600 font-black">0 Pcs</strong>
